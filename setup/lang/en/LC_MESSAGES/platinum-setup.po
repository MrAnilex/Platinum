# Platinum's setup (en): the texts of setup/ui/setup.slint and of setup/src/*.rs.
# Source texts are French; an entry left untranslated shows in French.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: en\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Désinstaller Platinum"
msgstr "Uninstall Platinum"

msgid "Installer Platinum"
msgstr "Install Platinum"

msgid "CE QUI SERA RETIRÉ"
msgstr "WHAT WILL BE REMOVED"

msgid "BIENVENUE"
msgstr "WELCOME"

msgid "DÉSINSTALLATION"
msgstr "UNINSTALLING"

msgid "INSTALLATION"
msgstr "INSTALLING"

msgid "TERMINÉ"
msgstr "DONE"

msgid "Platinum et ses programmes vont être retirés de cet ordinateur."
msgstr "Platinum and its programs will be removed from this computer."

msgid "Platinum est un mixeur et des effets audio pour le pilote Sonar, sans SteelSeries GG."
msgstr "Platinum is a mixer and audio effects for the Sonar driver, without SteelSeries GG."

msgid "LA DÉSINSTALLATION VA"
msgstr "THE UNINSTALL WILL"

msgid "L'INSTALLATION VA"
msgstr "THE INSTALL WILL"

msgid "Supprimer aussi mes réglages et préréglages"
msgstr "Also delete my settings and presets"

msgid "platinum.ini, vos préréglages et l'état de Platinum. Sinon, ils restent pour une prochaine installation."
msgstr "platinum.ini, your presets and Platinum's state. Otherwise they stay for a later install."

msgid "Désinstaller aussi le pilote Sonar"
msgstr "Also uninstall the Sonar driver"

msgid "Installé par Platinum. Windows demandera une autorisation d'administrateur, et le son se coupera quelques secondes."
msgstr "Installed by Platinum. Windows will ask for administrator permission, and the sound will stop for a few seconds."

msgid "Platinum est un logiciel libre, sous licence GNU GPL v3. Il n'est ni affilié à SteelSeries, ni approuvé par SteelSeries."
msgstr "Platinum is free software under the GNU GPL v3. It is neither affiliated with nor endorsed by SteelSeries."

msgid "OPTIONS"
msgstr "OPTIONS"

msgid "Démarrer Platinum avec Windows"
msgstr "Start Platinum with Windows"

msgid "Le service de Platinum démarre à l'ouverture de session, sans fenêtre."
msgstr "Platinum's service starts when you sign in, without a window."

msgid "Raccourci sur le bureau"
msgstr "Desktop shortcut"

msgid "Pendant l'installation du pilote, Windows demandera une autorisation d'administrateur et le son se coupera quelques secondes."
msgstr "While the driver installs, Windows will ask for administrator permission and the sound will stop for a few seconds."

msgid "Ouvrir le journal"
msgstr "Open the log"

msgid "Annuler"
msgstr "Cancel"

msgid "Retour"
msgstr "Back"

msgid "Réessayer"
msgstr "Retry"

msgid "Suivant"
msgstr "Next"

msgid "Désinstaller"
msgstr "Uninstall"

msgid "Installer"
msgstr "Install"

msgid "Ouvrir Platinum"
msgstr "Open Platinum"

msgid "Fermer"
msgstr "Close"

msgid "Terminé."
msgstr "Done."

msgid "La partie administrateur n'a pas reçu les droits d'administrateur."
msgstr "The administrator part did not get administrator rights."

msgid "La partie administrateur a reçu des arguments incorrects."
msgstr "The administrator part was given wrong arguments."

msgid "Le runtime Visual C++ n'a pas pu être installé : voyez le journal."
msgstr "The Visual C++ runtime could not be installed: see the log."

msgid "Les fichiers du pilote n'ont pas pu être copiés dans %ProgramData%\\Platinum : voyez le journal."
msgstr "The driver files could not be copied into %ProgramData%\\Platinum: see the log."

msgid "Les fichiers du pilote ne portent pas les signatures attendues de SteelSeries et de Microsoft : rien n'a été installé."
msgstr "The driver files do not carry the expected SteelSeries and Microsoft signatures: nothing was installed."

msgid "Le pilote Sonar n'a pu être installé ni par l'outil de SteelSeries ni par les fonctions de Windows : voyez le journal."
msgstr "The Sonar driver could be installed neither by SteelSeries' tool nor with Windows' own functions: see the log."

msgid "Le pilote Sonar n'a pu être retiré ni par l'outil de SteelSeries ni par les fonctions de Windows : voyez le journal."
msgstr "The Sonar driver could be removed neither by SteelSeries' tool nor with Windows' own functions: see the log."

msgid "Installation annulée."
msgstr "Install cancelled."

msgid "SteelSeries GG démarre encore avec Windows : désactivez-le dans le Gestionnaire des tâches (Applications de démarrage) pour laisser la main à Platinum."
msgstr "SteelSeries GG still starts with Windows: disable it in Task Manager (Startup apps) to let Platinum take over."

msgid "Windows demande un redémarrage pour finir d'installer le pilote."
msgstr "Windows asks for a restart to finish installing the driver."

msgid "Platinum est installé."
msgstr "Platinum is installed."

msgid "Le son passe sans Platinum pendant quelques secondes."
msgstr "Sound goes without Platinum for a few seconds."

msgid "Vérification de la signature de SteelSeries…"
msgstr "Checking SteelSeries' signature…"

msgid "Extraction du pilote Sonar (seuls 42 Mo sur 1,3 Go sont gardés)…"
msgstr "Extracting the Sonar driver (only 42 MB of 1.3 GB are kept)…"

msgid "Windows demande l'autorisation d'installer le pilote. Le son se coupera quelques secondes pendant le redémarrage du service Audio de Windows."
msgstr "Windows asks for permission to install the driver. Sound will stop for a few seconds while the Windows Audio service restarts."

msgid "Windows demande l'autorisation d'installer le runtime Visual C++."
msgstr "Windows asks for permission to install the Visual C++ runtime."

msgid "L'autorisation d'administrateur a été refusée : rien n'a été installé. Cliquez sur Réessayer pour la redemander."
msgstr "Administrator permission was refused: nothing was installed. Click Retry to ask again."

msgid "Attente des périphériques audio Sonar…"
msgstr "Waiting for the Sonar audio devices…"

msgid "Le pilote Sonar n'est pas installé après les outils de SteelSeries : voyez le journal."
msgstr "The Sonar driver is not installed after SteelSeries' tools ran: see the log."

msgid "Les réglages du module audio Sonar n'ont pas été créés : voyez le journal."
msgstr "The Sonar audio module's settings were not created: see the log."

msgid "Les périphériques audio Sonar n'apparaissent pas encore : redémarrez Windows si le son ne passe pas par Platinum."
msgstr "The Sonar audio devices do not show yet: restart Windows if sound does not go through Platinum."

msgid "Cet installateur a été compilé sans les programmes de Platinum : utilisez scripts\\build-setup.ps1."
msgstr "This setup was built without Platinum's programs: use scripts\\build-setup.ps1."

msgid "Platinum n'a pas pu s'inscrire au démarrage de Windows : voyez le journal."
msgstr "Platinum could not register to start with Windows: see the log."

msgid "Mixeur et effets audio"
msgstr "Audio mixer and effects"

msgid "Le journal de l'installation : {file}"
msgstr "The install log: {file}"

msgid "Le runtime Visual C++ ne peut pas être téléchargé (HTTP {status})."
msgstr "The Visual C++ runtime cannot be downloaded (HTTP {status})."

msgid "Le runtime téléchargé n'est pas signé par Microsoft : {error}"
msgstr "The downloaded runtime is not signed by Microsoft: {error}"

msgid "Le téléchargement a échoué : {error}"
msgstr "The download failed: {error}"

msgid "L'installateur de SteelSeries GG ne peut pas être téléchargé (HTTP {status})."
msgstr "SteelSeries GG's installer cannot be downloaded (HTTP {status})."

msgid "L'installateur testé (GG {pinned}) n'est plus en ligne : le pilote vient de {name}."
msgstr "The tested installer (GG {pinned}) is no longer online: the driver comes from {name}."

msgid "Le fichier téléchargé ne correspond pas à l'installateur attendu (SHA-256 {digest}) : il a été supprimé, réessayez."
msgstr "The downloaded file does not match the expected installer (SHA-256 {digest}): it was deleted, try again."

msgid "L'installateur téléchargé n'est pas signé par SteelSeries : {error}"
msgstr "The downloaded installer is not signed by SteelSeries: {error}"

msgid "Cet installateur n'est pas signé par SteelSeries : {error}"
msgstr "This installer is not signed by SteelSeries: {error}"

msgid "Le pilote ne peut pas être extrait de l'installateur : {error}"
msgstr "The driver cannot be extracted from the installer: {error}"

msgid "Des fichiers du pilote manquent dans cet installateur : {files}"
msgstr "Driver files are missing from this installer: {files}"

msgid "La partie administrateur n'a pas pu démarrer : {error}"
msgstr "The administrator part could not start: {error}"

msgid "Impossible de créer {folder} : {error}"
msgstr "Cannot create {folder}: {error}"

msgid "Impossible d'écrire {file} : {error}"
msgstr "Cannot write {file}: {error}"

msgid "Le raccourci {file} n'a pas pu être créé : {error}"
msgstr "The shortcut {file} could not be created: {error}"

msgid "Platinum n'a pas pu démarrer : {error}"
msgstr "Platinum could not start: {error}"

msgid "Téléchargement du runtime Visual C++ : {done} Mo sur {total} Mo"
msgstr "Downloading the Visual C++ runtime: {done} MB of {total} MB"

msgid "Téléchargement de l'installateur de SteelSeries GG : {done} Mo sur {total} Mo"
msgstr "Downloading SteelSeries GG's installer: {done} MB of {total} MB"

msgid "Télécharger le runtime Visual C++ de Microsoft"
msgstr "Download Microsoft's Visual C++ runtime"

msgid "Télécharger l'installateur officiel de SteelSeries GG"
msgstr "Download SteelSeries GG's official installer"

msgid "Extraire le pilote Sonar et les préréglages"
msgstr "Extract the Sonar driver and the presets"

msgid "Installer le pilote Sonar (administrateur)"
msgstr "Install the Sonar driver (administrator)"

msgid "Vérifier le pilote et les périphériques audio"
msgstr "Check the driver and the audio devices"

msgid "Arrêter Platinum"
msgstr "Stop Platinum"

msgid "Copier Platinum"
msgstr "Copy Platinum"

msgid "Démarrage avec Windows"
msgstr "Start with Windows"

msgid "Raccourcis"
msgstr "Shortcuts"

msgid "Inscrire Platinum dans les applications installées"
msgstr "Add Platinum to the installed apps"

msgid "Démarrer Platinum"
msgstr "Start Platinum"

msgid "Supprimer les fichiers téléchargés"
msgstr "Delete the downloaded files"

msgid "Windows demande un redémarrage pour finir de retirer le pilote."
msgstr "Windows asks for a restart to finish removing the driver."

msgid "SteelSeries GG est toujours installé : réactivez son démarrage avec Windows si vous voulez le retrouver."
msgstr "SteelSeries GG is still installed: enable its start with Windows again if you want it back."

msgid "Platinum est désinstallé."
msgstr "Platinum is uninstalled."

msgid "Windows demande l'autorisation de retirer le pilote. Le son se coupera quelques secondes."
msgstr "Windows asks for permission to remove the driver. Sound will stop for a few seconds."

msgid "L'autorisation d'administrateur a été refusée : le pilote Sonar est resté installé."
msgstr "Administrator permission was refused: the Sonar driver stays installed."

msgid "Vos réglages et préréglages restent dans {folder}."
msgstr "Your settings and presets stay in {folder}."

msgid "Impossible de supprimer {file} : {error}"
msgstr "Cannot delete {file}: {error}"

msgid "Retirer le démarrage avec Windows"
msgstr "Remove the start with Windows"

msgid "Remettre les noms d'origine des périphériques audio"
msgstr "Put back the audio devices' original names"

msgid "Supprimer les programmes de Platinum"
msgstr "Delete Platinum's programs"

msgid "Supprimer les raccourcis"
msgstr "Delete the shortcuts"

msgid "Retirer Platinum des applications installées"
msgstr "Remove Platinum from the installed apps"

msgid "Supprimer vos réglages et préréglages"
msgstr "Delete your settings and presets"

msgid "Désinstaller le pilote Sonar (administrateur)"
msgstr "Uninstall the Sonar driver (administrator)"

msgid "Télécharger l'installateur officiel de SteelSeries GG (environ 434 Mo) depuis steelseries.com, et n'en garder que le pilote Sonar, ses modules d'effets et les préréglages de GG (environ 42 Mo)."
msgstr "Download SteelSeries GG's official installer (about 434 MB) from steelseries.com, and keep only the Sonar driver, its effects modules and GG's presets (about 42 MB)."

msgid "Reprendre le pilote Sonar déjà extrait par une installation précédente de Platinum."
msgstr "Reuse the Sonar driver already extracted by an earlier Platinum install."

msgid "Le pilote Sonar est déjà installé : rien à télécharger de SteelSeries."
msgstr "The Sonar driver is already installed: nothing to download from SteelSeries."

msgid "Installer le pilote Sonar avec les outils de SteelSeries, comme le fait GG (autorisation d'administrateur, son coupé quelques secondes). GG lui-même n'est pas installé."
msgstr "Install the Sonar driver with SteelSeries' own tools, as GG does (administrator permission, sound stops for a few seconds). GG itself is not installed."

msgid "Installer le runtime Visual C++ de Microsoft, nécessaire aux effets du micro."
msgstr "Install Microsoft's Visual C++ runtime, needed by the microphone effects."

msgid "Ajouter Platinum au menu Démarrer et aux applications installées, puis le démarrer."
msgstr "Add Platinum to the Start menu and the installed apps, then start it."

msgid "Arrêter Platinum et remettre les périphériques audio par défaut de Windows."
msgstr "Stop Platinum and put back Windows' default audio devices."

msgid "Retirer son démarrage avec Windows, ses programmes, ses raccourcis et son entrée dans les applications installées."
msgstr "Remove its start with Windows, its programs, its shortcuts and its entry in the installed apps."

msgid "Le pilote Sonar reste installé : il appartient à SteelSeries GG."
msgstr "The Sonar driver stays installed: it belongs to SteelSeries GG."

msgid "Le pilote Sonar reste installé : Platinum ne l'a pas installé."
msgstr "The Sonar driver stays installed: Platinum did not install it."

msgid "Le pilote Sonar n'existe que pour Windows 64 bits sur processeur x64."
msgstr "The Sonar driver exists only for 64-bit Windows on x64 processors."

msgid "Prendre le pilote Sonar et les préréglages dans l'installateur de GG indiqué : {file}."
msgstr "Take the Sonar driver and the presets from the given GG installer: {file}."

msgid "Mettre à jour Platinum dans {folder} : vos réglages et préréglages sont gardés."
msgstr "Update Platinum in {folder}: your settings and presets are kept."

msgid "Copier Platinum dans {folder}, sans droits d'administrateur."
msgstr "Copy Platinum into {folder}, without administrator rights."

msgid "SteelSeries GG est ouvert ({programs}). Quittez-le (icône près de l'horloge, Quitter), puis cliquez sur Réessayer. Désactivez aussi son démarrage avec Windows (Gestionnaire des tâches, Applications de démarrage)."
msgstr "SteelSeries GG is open ({programs}). Quit it (icon next to the clock, Quit), then click Retry. Also disable its start with Windows (Task Manager, Startup apps)."

msgid "Le pilote Sonar demande Windows 10 version 1809 ou plus récente (cet ordinateur : build {build})."
msgstr "The Sonar driver needs Windows 10 version 1809 or later (this computer: build {build})."

msgid "LICENCES ET OPTIONS"
msgstr "LICENCES AND OPTIONS"

msgid "LICENCE DE STEELSERIES GG"
msgstr "STEELSERIES GG LICENCE"

msgid "LICENCES"
msgstr "LICENCES"

msgid "Le pilote Sonar et ses modules d'effets appartiennent à SteelSeries et ne sont pas fournis avec Platinum. La licence de SteelSeries GG vous sera présentée une fois leur installateur officiel téléchargé et vérifié : rien n'est installé avant que vous l'acceptiez. GG lui-même n'est pas installé."
msgstr "The Sonar driver and its effects modules belong to SteelSeries and are not shipped with Platinum. SteelSeries GG's licence will be shown to you once their official installer is downloaded and checked: nothing is installed before you accept it. GG itself is not installed."

msgid "Lisez la licence de SteelSeries GG. Le pilote Sonar et ses modules d'effets sont soumis à cette licence. Rien n'est installé tant que vous ne l'avez pas acceptée."
msgstr "Read SteelSeries GG's licence. The Sonar driver and its effects modules are subject to it. Nothing is installed until you accept it."

msgid "J'ai lu et j'accepte la licence de SteelSeries GG"
msgstr "I have read and accept SteelSeries GG's licence"

msgid "Refuser"
msgstr "Decline"

msgid "Accepter"
msgstr "Accept"

msgid "Rien n'a été installé."
msgstr "Nothing was installed."

msgid "La licence de SteelSeries GG a été refusée : l'installateur téléchargé a été supprimé."
msgstr "SteelSeries GG's licence was declined: the downloaded installer was deleted."

msgid "Lecture de la licence de SteelSeries GG dans leur installateur…"
msgstr "Reading SteelSeries GG's licence from their installer…"

msgid "En attente de votre réponse à la licence de SteelSeries GG…"
msgstr "Waiting for your answer to SteelSeries GG's licence…"

msgid "Le texte de la licence de SteelSeries GG ne peut pas être lu : rien n'est installé ({error})."
msgstr "SteelSeries GG's licence text cannot be read: nothing is installed ({error})."

msgid "Le texte de la licence de SteelSeries GG ne peut pas être lu dans leur installateur : rien n'est installé ({error})."
msgstr "SteelSeries GG's licence text cannot be read from their installer: nothing is installed ({error})."

msgid "Lire et accepter la licence de SteelSeries GG"
msgstr "Read and accept SteelSeries GG's licence"

msgid "Vous montrer la licence de SteelSeries GG, tirée de leur installateur officiel : rien n'est installé avant que vous l'acceptiez."
msgstr "Show you SteelSeries GG's licence, taken from their official installer: nothing is installed before you accept it."

msgid "Tirée de l'installateur officiel de SteelSeries GG {version}, vérifié par sa signature."
msgstr "Taken from SteelSeries GG {version}'s official installer, checked by its signature."

#: setup/ui/setup.slint
msgid "Proposer d'envoyer les rapports de plantage (anonymisés, via GitHub, toujours après votre accord)"
msgstr "Offer to send crash reports (anonymised, through GitHub, always after your consent)"

#: setup/ui/setup.slint
msgid "Les plantages sont toujours notés sur ce PC. Activé, Platinum vous propose après un plantage d'envoyer le rapport : vous le lisez, puis vous l'envoyez vous-même depuis votre navigateur. Rien n'est jamais envoyé automatiquement. Modifiable ensuite dans les Paramètres de Platinum."
msgstr "Crashes are always recorded on this PC. When on, Platinum offers to send the report after a crash: you read it, then send it yourself from your browser. Nothing is ever sent automatically. Can be changed later in Platinum's Settings."
