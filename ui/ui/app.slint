// Platinum's window. The arrangement follows GG's Sonar screen (a Mixer tab with one strip per
// channel and the applications routed to it, then one tab per channel with its equalizer and
// effect cards); the look is Platinum's own: graphite, brushed-metal faders, segmented meters.
// Everything shown comes from src/main.rs; every action goes back through the Backend global.
//
// Every control is controlled: it shows what Rust put in its property and asks for a change
// through a callback, and Rust updates the model at once (the engine confirms it later). No
// component assigns the value it shows, which would cut its binding to the model.

import { ScrollView } from "std-widgets.slint";
import { Palette, Label, Meter, Fader, Toggle, LevelBox, IconButton, Button, Select, MenuFrame, MenuSeparator, ValueEdit } from "controls.slint";
import { Icon } from "icons.slint";
import { BandView, MarkerView, EqEditor } from "eq.slint";
import { Backend, Field, CardKind, PresetTile, PresetHeader, RenderView, CaptureView, SpeakerView, RunningApp, GameLinkView, Section, LinkRow, AboutView } from "backend.slint";
import { RenderCards, CaptureCards } from "cards.slint";
import { PresetBar, CurrentPreset, FavoritesBar, BrowseOverlay, NameDialog, LinkDialog } from "presets.slint";
import { PriorityRow } from "devices.slint";
import { ShortcutRow, ShortcutGroup } from "shortcuts.slint";
import { SettingsPage } from "settings.slint";
import { TestSample, MicTest, TypedValue, Preview, CrashRow } from "backend.slint";
import { TestBar, MicTestBar } from "tester.slint";

export { BandView, MarkerView, EqEditor, Backend, PresetTile, PresetHeader, RenderView, CaptureView, SpeakerView, PriorityRow, ShortcutRow, ShortcutGroup, TestSample, MicTest, LinkRow, AboutView, TypedValue, Preview, CrashRow }

export struct AppPill {
    // How Rust knows the pill: the executable, with "capture:" in front for a recording one.
    key: string,
    exe: string,
    name: string,
    playing: bool,
    // The real device it plays to (or records from), for an application that goes around the
    // channels.
    device: string,
    // It records from a microphone instead of playing.
    capture: bool,
    // It opens its audio device itself (GG's list): a route may not reach its sound.
    hint: bool,
    // Its sound did not follow its last route.
    refused: bool,
}

export struct ColumnView {
    key: string,
    title: string,
    icon: string,
    // The channel's settings could be read; when false the other values are not real.
    readable: bool,
    // The classic volume, which is also the personal mix's in streamer mode.
    volume: float,
    muted: bool,
    // Streamer mode: the stream mix's volume and mute, and whether the channel is in each mix.
    stream-volume: float,
    stream-muted: bool,
    in-personal: bool,
    in-stream: bool,
    // The "Effets" switch (the preset's globalEnableState).
    processing: bool,
    output-index: int,
    apps: [AppPill],
    // The preset it uses, and its favourites for the strip's menu.
    preset: string,
    favorites: [PresetTile],
}

// Something the user should know, kept until dismissed.
export struct NoticeView {
    id: int,
    text: string,
    detail: string,
}

// The daemon as the window shows it (src/background.rs).
export struct DaemonState {
    // running, degraded, starting, waiting, stopping, stopped, failed, gg
    phase: string,
    // The word in the header: @tr("Actif"), @tr("Démarrage…")…
    label: string,
    summary: string,
    detail: string,
    microphone: string,
    can-start: bool,
    can-stop: bool,
    restarts-on-mic-change: bool,
    // The line above the mixer while the sound does not go through Platinum, or goes to a remote
    // streaming session; empty otherwise.
    banner: string,
    // 0 information, 1 warning, 2 error.
    banner-tone: int,
    // What the popover says while the daemon follows a remote streaming session; empty otherwise.
    remote: string,
}

// Where the mixer's strips sit, so that a dragged application knows where it is dropped.
global Geometry {
    out property <length> pad: 24px;
    out property <length> master: 206px;
    // Streamer mode's Master, wider for its two faders and the two mixes' device menus.
    out property <length> master-streamer: 250px;
    out property <length> strip: 168px;
    out property <length> gap: 10px;
    out property <length> top: 64px;
}

// An application being dragged between strips. Exported so that the window can clear a drag that
// lost its pointer (src/main.rs checks it every second).
export global Drag {
    // The dragged pill's key (AppPill.key); empty when none is dragged.
    in-out property <string> key;
    in-out property <string> name;
    // A recording application: only the Master and the Micro strip take it.
    in-out property <bool> capture;
    in-out property <int> from: -1;
    // The strip under the pointer (0 Master, 1 to 4 Gaming to Aux, 5 Micro), -1 when none.
    in-out property <int> target: -1;
    in-out property <length> x;
    in-out property <length> y;
}

// The explanation of a pill's mark, drawn above everything while the pointer is on the pill (the
// lists clip what goes past their edges).
export global Hint {
    // The pill it explains (AppPill.key): src/main.rs clears a hint whose pill is gone.
    in-out property <string> key;
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
}

component Pill inherits Rectangle {
    in property <AppPill> app;
    in property <int> strip;
    height: 24px;
    border-radius: 3px;
    background: area.has-hover ? Palette.edge : Palette.raised;
    opacity: Drag.key == root.app.key ? 0.35 : 1;
    // GG's words for an application that opens its device itself, or whose sound did not follow.
    property <string> explanation: root.app.refused
        ? @tr("{0} n'a pas autorisé Platinum à modifier ses paramètres audio. Ajustez les paramètres audio directement dans {0}.", root.app.name)
        : (root.app.hint ? @tr("Il est possible que {0} n'autorise pas Platinum à modifier ses paramètres audio. Si besoin, ajustez les paramètres audio directement dans {0}.", root.app.name) : "");
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 7px;
        Rectangle {
            width: 6px;
            height: 6px;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: root.app.playing ? Palette.signal : Palette.faint;
        }
        Text {
            horizontal-stretch: 0;
            text: root.app.name;
            color: Palette.text;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.app.device != "": Text {
            horizontal-stretch: 1;
            text: root.app.device;
            color: Palette.faint;
            font-size: 10px;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.explanation != "": Icon {
            y: (parent.height - self.height) / 2;
            name: root.app.refused ? "alert" : "info";
            size: 13px;
            tint: root.app.refused ? Palette.amber : Palette.dim;
        }
    }
    area := TouchArea {
        mouse-cursor: Drag.key == "" ? grab : grabbing;
        changed has-hover => {
            if (self.has-hover && root.explanation != "") {
                Hint.key = root.app.key;
                Hint.text = root.explanation;
                Hint.x = self.absolute-position.x;
                Hint.y = self.absolute-position.y + root.height + 4px;
            } else if (Hint.text == root.explanation) {
                Hint.text = "";
            }
        }
        moved => {
            if (self.pressed && (abs((self.mouse-x - self.pressed-x) / 1px) > 4 || abs((self.mouse-y - self.pressed-y) / 1px) > 4)) {
                Drag.key = root.app.key;
                Drag.name = root.app.name;
                Drag.capture = root.app.capture;
                Drag.from = root.strip;
                Drag.x = self.absolute-position.x + self.mouse-x;
                Drag.y = self.absolute-position.y + self.mouse-y;
                Hint.text = "";
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && Drag.key != "") {
                if (Drag.target >= 0 && Drag.target != Drag.from) {
                    Backend.route-app(Drag.key, Drag.target);
                }
                Drag.key = "";
                Drag.from = -1;
                Drag.target = -1;
            }
            // The press was taken away (the window lost the mouse): drop nothing.
            if (event.kind == PointerEventKind.cancel) {
                Drag.key = "";
                Drag.from = -1;
                Drag.target = -1;
            }
        }
    }
}

component AppsBox inherits Rectangle {
    in property <[AppPill]> apps;
    in property <int> strip;
    in property <string> caption: @tr("APPLICATIONS");
    in property <string> drop-hint: @tr("Déposer ici");
    // What an empty list says.
    in property <string> empty: "—";
    // A small link at the right of the caption; empty for none.
    in property <string> action;
    callback act();
    property <bool> drop-here: Drag.key != "" && Drag.from != root.strip && Drag.target == root.strip;
    height: 116px;
    border-radius: 4px;
    background: Palette.well;
    border-width: 1px;
    border-color: root.drop-here ? Palette.light : Palette.hairline;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            Label {
                text: root.caption;
            }
            Rectangle { }
            if root.action != "": Text {
                text: root.action;
                color: link.has-hover ? Palette.text : Palette.dim;
                font-size: 10px;
                vertical-alignment: center;
                link := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.act(); }
                }
            }
        }
        Flickable {
            preferred-width: 0;
            preferred-height: 0;
            vertical-stretch: 1;
            content-height: list.preferred-height;
            // Dragging a pill must move the pill, not scroll the list (the wheel still scrolls).
            mouse-drag-pan-enabled: false;
            list := VerticalLayout {
                alignment: start;
                spacing: 4px;
                for app in root.apps: Pill {
                    app: app;
                    strip: root.strip;
                }
            }
        }
        if root.apps.length == 0: Text {
            text: root.drop-here ? root.drop-hint : root.empty;
            color: Palette.faint;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

// A horizontal slider centred on 0, from -1 to 1: ChatMix.
component Balance inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    callback moved(float);
    height: 24px;
    opacity: root.enabled ? 1 : 0.35;
    property <length> cap: 14px;
    function set-from(x: length) {
        root.moved(max(-1, min(1, (x - root.cap / 2) / (root.width - root.cap) * 2 - 1)));
    }
    Rectangle {
        x: root.cap / 2;
        y: (root.height - self.height) / 2;
        width: root.width - root.cap;
        height: 4px;
        border-radius: 2px;
        background: Palette.well;
    }
    Rectangle {
        x: (root.width - self.width) / 2;
        y: 3px;
        width: 1px;
        height: root.height - 6px;
        background: Palette.edge;
    }
    Rectangle {
        x: (root.width - root.cap) * (root.value + 1) / 2;
        y: (root.height - self.height) / 2;
        width: root.cap;
        height: 20px;
        border-radius: 3px;
        background: @linear-gradient(180deg, Palette.metal-top 0%, Palette.metal-bottom 100%);
        drop-shadow-blur: 4px;
        drop-shadow-color: #000000a0;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
        double-clicked => { root.moved(0); }
    }
}

// The frame shared by every mixer strip: header, then the strip's own rows.
component StripFrame inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <bool> openable: true;
    // Where an application dropped here goes (0 Master, 1 to 4 Gaming to Aux, 5 Micro), -1 for
    // none; which kinds of application it takes.
    in property <int> drop-index: -1;
    in property <bool> takes-playing: true;
    in property <bool> takes-recording: false;
    callback open();
    property <bool> under: root.drop-index >= 0 && Drag.key != "" && (Drag.capture ? root.takes-recording : root.takes-playing)
        && Drag.x >= self.absolute-position.x && Drag.x < self.absolute-position.x + self.width
        && Drag.y >= self.absolute-position.y && Drag.y < self.absolute-position.y + self.height;
    changed under => {
        if (self.under) {
            Drag.target = root.drop-index;
        } else if (Drag.target == root.drop-index) {
            Drag.target = -1;
        }
    }
    border-radius: 6px;
    background: Palette.panel;
    border-width: 1px;
    border-color: root.under && Drag.from != root.drop-index ? Palette.light : Palette.hairline;
    VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            height: 26px;
            spacing: 8px;
            Icon {
                y: (parent.height - self.height) / 2;
                name: root.icon;
                size: 18px;
                tint: Palette.text;
            }
            Text {
                text: root.title;
                color: Palette.text;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.4px;
                vertical-alignment: center;
            }
            Rectangle { }
            if root.openable: IconButton {
                width: 26px;
                height: 26px;
                icon: "settings";
                clicked => { root.open(); }
            }
        }
        Rectangle {
            height: 1px;
            background: Palette.hairline;
        }
        @children
    }
}

// The big number under a fader, with its mute button. The number can be typed (ValueEdit): what
// is typed is read as a percentage, kept within 0 to 100 and rounded to 1 %, then written as the
// fader would (`moved`).
component VolumeRow inherits HorizontalLayout {
    in property <float> value;
    in property <bool> known: true;
    in property <bool> muted;
    in property <bool> enabled: true;
    callback mute-clicked();
    callback moved(float);
    height: 30px;
    ValueEdit {
        text: root.known ? "\{round(root.value * 100)}" : "—";
        number: "\{round(root.value * 100)}";
        enabled: root.enabled && root.known;
        centered: false;
        text-color: root.muted || !root.known ? Palette.faint : Palette.text;
        font-size: 22px;
        font-weight: 300;
        accepted(typed) => {
            if (Backend.typed-value(typed, 0, 1, 0.01, true).ok) {
                root.moved(Backend.typed-value(typed, 0, 1, 0.01, true).value);
            }
        }
    }
    Text {
        text: root.known ? " %" : "";
        color: Palette.faint;
        font-size: 11px;
        vertical-alignment: center;
    }
    Rectangle { }
    IconButton {
        icon: root.muted ? "muted" : "speaker";
        active: root.muted && root.known;
        enabled: root.enabled && root.known;
        clicked => { root.mute-clicked(); }
    }
}

// What a strip shows instead of its fader when its settings cannot be read.
component Unreadable inherits Rectangle {
    height: 230px;
    border-radius: 4px;
    background: Palette.well;
    border-width: 1px;
    border-color: Palette.hairline;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Icon {
                name: "alert";
                size: 22px;
                tint: Palette.amber;
            }
        }
        Text {
            text: @tr("Réglages illisibles");
            color: Palette.text;
            font-size: 12px;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("Le module audio de SteelSeries ne répond pas pour ce canal.");
            color: Palette.dim;
            font-size: 11px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// A strip's first row, as in GG: its preset (a click opens the favourites and "Parcourir…"),
// then Platinum's "Effets" switch for the whole channel.
component PresetRow inherits HorizontalLayout {
    in property <ColumnView> column;
    // The tab that shows this channel.
    in property <int> page;
    in property <int> open-request: -1;
    height: 24px;
    spacing: 8px;
    PresetBar {
        name: root.column.readable ? root.column.preset : "—";
        favorites: root.column.favorites;
        enabled: root.column.readable;
        index: root.page;
        open-request: root.open-request;
        choose(key) => { Backend.select-preset(root.column.key, key); }
        browse => {
            Backend.open-page(root.page);
            Backend.open-browse(root.column.key);
        }
    }
    Toggle {
        y: (parent.height - self.height) / 2;
        on: root.column.processing && root.column.readable;
        enabled: root.column.readable;
        toggled(on) => { Backend.edit(root.column.key, Field.global-enable, on ? 1 : 0); }
    }
}

// A channel's place in a mix (streamer mode), as GG's dots above its two sliders: lit when the
// channel is in the mix; a click puts it in or takes it out ("Ajouter au mix personnel / de stream").
component MixDot inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: 30px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 22px;
        border-radius: 11px;
        opacity: root.enabled ? 1 : 0.35;
        background: area.has-hover && root.enabled ? Palette.raised : transparent;
        border-width: 1px;
        border-color: root.on ? Palette.edge : Palette.hairline;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 5px;
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.on ? Palette.light : transparent;
                border-width: 1px;
                border-color: root.on ? Palette.light : Palette.faint;
            }
            Text {
                text: root.text;
                color: root.on ? Palette.text : Palette.faint;
                font-size: 9px;
                font-weight: 600;
                letter-spacing: 0.6px;
                vertical-alignment: center;
            }
        }
        area := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.toggled(!root.on); }
        }
    }
}

// A smaller value and mute button, for each mix of streamer mode.
component MiniVolume inherits HorizontalLayout {
    in property <float> value;
    in property <bool> known: true;
    in property <bool> muted;
    // Out of the mix: the value is shown dim.
    in property <bool> dim;
    in property <bool> enabled: true;
    // A small icon before the value (the Master's two mixes); none when empty.
    in property <string> icon;
    callback mute-clicked();
    // A value typed over the number, as VolumeRow's.
    callback moved(float);
    height: 30px;
    spacing: 4px;
    if root.icon != "": Icon {
        y: (parent.height - self.height) / 2;
        name: root.icon;
        size: 14px;
        tint: Palette.dim;
    }
    HorizontalLayout {
        ValueEdit {
            text: root.known ? "\{round(root.value * 100)}" : "—";
            number: "\{round(root.value * 100)}";
            enabled: root.enabled && root.known;
            centered: false;
            text-color: root.muted || root.dim || !root.known ? Palette.faint : Palette.text;
            font-size: 15px;
            font-weight: 300;
            accepted(typed) => {
                if (Backend.typed-value(typed, 0, 1, 0.01, true).ok) {
                    root.moved(Backend.typed-value(typed, 0, 1, 0.01, true).value);
                }
            }
        }
        Text {
            text: root.known ? " %" : "";
            color: Palette.faint;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
    Rectangle { }
    IconButton {
        y: (parent.height - self.height) / 2;
        width: 26px;
        height: 26px;
        icon: root.muted ? "muted" : "speaker";
        active: root.muted && root.known;
        enabled: root.enabled && root.known;
        clicked => { root.mute-clicked(); }
    }
}

// One mix of a streamer strip, or of the streamer Master: the channel's dot (none for the
// Master), its meter and fader, its value and mute.
component MixColumn inherits VerticalLayout {
    in property <string> caption;
    in property <bool> dot: true;
    in property <string> icon;
    in property <bool> included: true;
    in property <float> value;
    in property <bool> muted;
    in property <float> level;
    in property <bool> enabled: true;
    callback include(bool);
    callback moved(float);
    callback mute-clicked();
    spacing: 10px;
    if root.dot: MixDot {
        text: root.caption;
        on: root.included;
        enabled: root.enabled;
        toggled(on) => { root.include(on); }
    }
    HorizontalLayout {
        height: 230px;
        alignment: center;
        spacing: 4px;
        Meter {
            level: root.included && !root.muted ? root.level : 0;
        }
        Fader {
            value: root.value;
            dimmed: root.muted || !root.included;
            enabled: root.enabled;
            moved(value) => { root.moved(value); }
        }
    }
    MiniVolume {
        value: root.value;
        muted: root.muted;
        dim: !root.included;
        enabled: root.enabled;
        icon: root.icon;
        mute-clicked => { root.mute-clicked(); }
        moved(value) => { root.moved(value); }
    }
}

// A device menu with its caption on its top edge, and optionally the device's Windows level: the
// streamer Master's personal mix, stream mix and microphone input (GG's `StreamModeDevices`).
component MixDevice inherits Rectangle {
    in property <string> caption;
    in property <[string]> model;
    in property <int> current;
    in property <string> placeholder: "—";
    in property <string> action;
    in property <string> action-icon: "devices";
    in property <bool> has-level: true;
    in property <float> level;
    in property <bool> level-known;
    in property <bool> level-muted;
    in property <bool> open-request;
    callback chosen(int);
    callback act();
    callback level-moved(float);
    height: 28px;
    HorizontalLayout {
        spacing: 6px;
        Select {
            height: 28px;
            model: root.model;
            current: root.current;
            placeholder: root.placeholder;
            action: root.action;
            action-icon: root.action-icon;
            open-request: root.open-request;
            chosen(index) => { root.chosen(index); }
            act => { root.act(); }
        }
        if root.has-level: LevelBox {
            height: 28px;
            value: root.level;
            known: root.level-known;
            muted: root.level-muted;
            moved(value) => { root.level-moved(value); }
        }
    }
    Rectangle {
        x: 7px;
        y: -6px;
        width: legend.preferred-width + 8px;
        height: 11px;
        background: Palette.panel;
        legend := Text {
            x: 4px;
            height: parent.height;
            text: root.caption;
            color: Palette.faint;
            font-size: 9px;
            font-weight: 600;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
    }
}

component Strip inherits StripFrame {
    in property <ColumnView> column;
    in property <float> level;
    in property <[string]> outputs;
    in property <int> index;
    in property <int> open-request: -1;
    // Streamer mode: two mixes instead of one output and one fader.
    in property <bool> streamer;
    icon: root.column.icon;
    title: root.column.title;
    drop-index: root.index;
    open => { Backend.open-page(root.index); }
    PresetRow {
        column: root.column;
        page: root.index;
        open-request: root.open-request;
    }
    if !root.streamer: Select {
        model: root.outputs;
        current: root.column.readable ? root.column.output-index : -1;
        enabled: root.column.readable;
        placeholder: root.column.readable ? "—" : @tr("Sortie inconnue");
        chosen(index) => { Backend.set-output(root.column.key, index); }
    }
    if !root.streamer && root.column.readable: HorizontalLayout {
        height: 230px;
        alignment: center;
        spacing: 12px;
        Meter {
            level: root.level;
        }
        Fader {
            value: root.column.volume;
            dimmed: root.column.muted;
            moved(value) => { Backend.set-volume(root.column.key, value); }
        }
    }
    if !root.streamer && !root.column.readable: Unreadable { }
    if !root.streamer: VolumeRow {
        value: root.column.volume;
        known: root.column.readable;
        muted: root.column.muted;
        mute-clicked => { Backend.set-muted(root.column.key, !root.column.muted); }
        moved(value) => { Backend.set-volume(root.column.key, value); }
    }
    // The personal mix (the classic volume) and the stream mix, side by side, as in GG.
    if root.streamer && root.column.readable: HorizontalLayout {
        spacing: 4px;
        MixColumn {
            width: 70px;
            caption: @tr("PERSO");
            included: root.column.in-personal;
            value: root.column.volume;
            muted: root.column.muted;
            level: root.level;
            include(on) => { Backend.set-inclusion(root.column.key, 0, on); }
            moved(value) => { Backend.set-volume(root.column.key, value); }
            mute-clicked => { Backend.set-muted(root.column.key, !root.column.muted); }
        }
        MixColumn {
            width: 70px;
            caption: @tr("STREAM");
            included: root.column.in-stream;
            value: root.column.stream-volume;
            muted: root.column.stream-muted;
            level: root.level;
            include(on) => { Backend.set-inclusion(root.column.key, 1, on); }
            moved(value) => { Backend.set-stream-volume(root.column.key, value); }
            mute-clicked => { Backend.set-stream-muted(root.column.key, !root.column.stream-muted); }
        }
    }
    if root.streamer && !root.column.readable: Unreadable {
        height: 310px;
    }
    AppsBox {
        apps: root.column.apps;
        strip: root.index;
    }
}

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    horizontal-stretch: 0;
    preferred-width: label.preferred-width + 28px;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.active ? Palette.text : (area.has-hover ? Palette.dim : Palette.faint);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.4px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        x: 8px;
        width: parent.width - 16px;
        background: root.active ? Palette.light : transparent;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// "Paramètres", next to the daemon's state: opens the settings page; lit while it is open.
component SettingsButton inherits Rectangle {
    in property <bool> active;
    callback clicked;
    width: label.preferred-width + 54px;
    height: 42px;
    border-radius: 4px;
    background: root.active || area.has-hover ? Palette.raised : transparent;
    border-width: 1px;
    border-color: root.active ? Palette.light : Palette.edge;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 9px;
        Icon {
            y: (parent.height - self.height) / 2;
            name: "settings";
            size: 16px;
            tint: root.active ? Palette.text : Palette.dim;
        }
        label := Text {
            text: @tr("Paramètres");
            color: Palette.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The colour of the daemon's state.
global Tone {
    pure public function of-phase(phase: string) -> color {
        return phase == "running" ? Palette.signal
            : phase == "failed" ? Palette.hot
            : phase == "stopped" ? Palette.faint
            : Palette.amber;
    }
}

// The daemon's state in the header; a click opens its popover (its state, start and stop; the
// options are on the settings page).
component DaemonControl inherits Rectangle {
    in property <DaemonState> daemon;
    callback ask-stop();
    public function open() {
        popover.show();
    }
    width: 250px;
    height: 42px;
    border-radius: 4px;
    background: area.has-hover ? Palette.raised : transparent;
    border-width: 1px;
    border-color: Palette.edge;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 10px;
        Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Tone.of-phase(root.daemon.phase);
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.daemon.label;
                color: Palette.text;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.daemon.microphone != "" ? root.daemon.microphone : @tr("Aucun micro choisi");
                color: Palette.faint;
                font-size: 10px;
                overflow: elide;
            }
        }
        Icon {
            y: (parent.height - self.height) / 2;
            name: "chevron";
            size: 14px;
            tint: Palette.dim;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { popover.show(); }
    }
    popover := PopupWindow {
        x: root.width - 340px;
        y: root.height + 6px;
        width: 340px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            background: Palette.raised;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.edge;
            drop-shadow-blur: 20px;
            drop-shadow-color: #000000c0;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: Tone.of-phase(root.daemon.phase);
                    }
                    Label {
                        text: "PLATINUM";
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.daemon.summary;
                    color: Palette.text;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Text {
                    text: root.daemon.microphone != "" ? @tr("Micro : {}", root.daemon.microphone) : @tr("Aucun micro choisi : choisissez-en un dans la colonne Micro du mixeur.");
                    color: Palette.dim;
                    font-size: 11px;
                    wrap: word-wrap;
                }
                // A remote streaming session followed: where the sound goes meanwhile.
                if root.daemon.remote != "": Rectangle {
                    border-radius: 4px;
                    background: #ffffff08;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Icon {
                            name: "remote";
                            size: 16px;
                            tint: Palette.light;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: root.daemon.remote;
                            color: Palette.text;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
                if root.daemon.detail != "": Rectangle {
                    border-radius: 4px;
                    background: root.daemon.phase == "failed" ? #f0565c18 : #f2c14e14;
                    VerticalLayout {
                        padding: 10px;
                        Text {
                            text: root.daemon.detail;
                            color: root.daemon.phase == "failed" ? Palette.hot : Palette.amber;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button {
                        text: @tr("Démarrer");
                        primary: root.daemon.can-start;
                        enabled: root.daemon.can-start;
                        clicked => {
                            Backend.start-daemon();
                            popover.close();
                        }
                    }
                    Button {
                        text: @tr("Arrêter…");
                        enabled: root.daemon.can-stop;
                        clicked => {
                            popover.close();
                            root.ask-stop();
                        }
                    }
                }
            }
        }
    }
}

// A question asked before something that cuts the sound.
component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> confirm: "";
    in property <string> cancel: @tr("Annuler");
    // A third answer, on the left (empty: none).
    in property <string> extra: "";
    callback confirmed();
    callback cancelled();
    callback extra-clicked();
    background: #000000a0;
    // Clicks outside the card do nothing (the card's buttons decide).
    TouchArea { }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: box.preferred-height;
        background: Palette.raised;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.edge;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000d0;
        box := VerticalLayout {
            padding: 22px;
            spacing: 14px;
            Text {
                text: root.title;
                color: Palette.text;
                font-size: 15px;
                font-weight: 700;
            }
            Text {
                text: root.text;
                color: Palette.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                if root.extra != "": Button {
                    text: root.extra;
                    clicked => { root.extra-clicked(); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Button {
                    text: root.cancel;
                    clicked => { root.cancelled(); }
                }
                if root.confirm != "": Button {
                    text: root.confirm;
                    primary: true;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}

// A crash report as it would be sent: anonymised, read here before anything happens. "Ouvrir sur
// GitHub" opens the browser on GitHub's new issue page, pre-filled; the user sends it there, or not.
component ReportDialog inherits Rectangle {
    in property <string> report;
    // Where the issue would go, or why none can be opened.
    in property <string> repository;
    in property <bool> repository-known;
    // What the last button did (copied, opened, cut to fit).
    in property <string> note;
    callback closed();
    background: #000000a0;
    TouchArea { }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(720px, parent.width - 48px);
        height: min(620px, parent.height - 48px);
        background: Palette.raised;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.edge;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000d0;
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text {
                text: @tr("Envoyer le rapport de plantage");
                color: Palette.text;
                font-size: 15px;
                font-weight: 700;
            }
            Text {
                text: @tr("Voici le rapport tel qu'il serait envoyé : votre nom d'utilisateur, celui du PC, les adresses e-mail et les noms de vos périphériques audio ont été remplacés. Relisez-le : vous pourrez encore le modifier sur GitHub avant de l'envoyer.");
                color: Palette.dim;
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle {
                vertical-stretch: 1;
                background: Palette.well;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.hairline;
                ScrollView {
                    VerticalLayout {
                        padding: 10px;
                        Text {
                            text: root.report;
                            color: Palette.text;
                            font-family: "Consolas";
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            Text {
                text: root.repository;
                color: root.repository-known ? Palette.dim : Palette.amber;
                font-size: 11px;
                wrap: word-wrap;
            }
            if root.note != "": Text {
                text: root.note;
                color: Palette.text;
                font-size: 11px;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: @tr("Copier le texte");
                    clicked => { Backend.crash-copy(); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Button {
                    text: @tr("Fermer");
                    clicked => { root.closed(); }
                }
                Button {
                    text: @tr("Ouvrir sur GitHub");
                    primary: true;
                    enabled: root.repository-known;
                    clicked => { Backend.crash-github(); }
                }
            }
        }
    }
}

export component App inherits Window {
    title: @tr("Platinum");
    icon: @image-url("icon.png");
    preferred-width: 1210px;
    preferred-height: 820px;
    min-width: 1210px;
    min-height: 760px;
    background: Palette.base;
    default-font-size: 12px;

    // Mixer
    in property <[ColumnView]> columns;
    in property <ColumnView> mic;
    in property <[float]> levels;
    in property <[string]> outputs;
    in property <float> master-volume;
    in property <bool> master-muted;
    // Every output channel could be read: the Master can rescale them.
    in property <bool> master-ready: true;
    in property <int> master-output-index;
    in property <float> master-level;
    in property <bool> master-level-known;
    in property <bool> master-device-muted;
    // Streamer mode (GG's "Streamer mode"): the Master shows the personal mix (the Master above)
    // and the stream mix, the two mixes' devices with their Windows levels, and the microphone's
    // input; each strip shows its two mixes.
    in property <bool> streamer;
    // The daemon follows remote streaming sessions (platinum.ini's follow_streaming), and routes
    // the applications playing on the streaming output meanwhile (streaming_route_apps).
    in property <bool> follow-streaming: true;
    in property <bool> route-apps: true;
    in property <float> stream-master-volume;
    in property <bool> stream-master-muted;
    // Index in `outputs` of the personal mix's device.
    in property <int> personal-output-index;
    in property <[string]> stream-outputs;
    in property <int> stream-output-index;
    in property <float> stream-level;
    in property <bool> stream-level-known;
    in property <bool> stream-device-muted;
    in property <[AppPill]> master-apps;
    // What dropping an application on the Master does (where it will play).
    in property <string> master-drop-hint;
    // The applications that record the virtual microphone.
    in property <[AppPill]> mic-apps;
    in property <float> chatmix;
    // The Gaming and Chat settings could both be read (ChatMix is two gains, one on each) and both
    // channels play to the same device.
    in property <bool> chatmix-ready: true;
    // Why ChatMix cannot be used (GG's words); empty when it can.
    in property <string> chatmix-reason;
    // Microphone: the real microphones, the one chosen, the virtual microphone's Windows volume.
    in property <[string]> mic-inputs;
    in property <[bool]> mic-hands-free;
    in property <int> mic-current: -1;
    in property <float> mic-volume;
    in property <bool> mic-volume-known;
    in property <bool> mic-muted;
    // Channel tab
    in-out property <int> page: 0;
    in property <string> channel-key;
    in property <bool> channel-readable: true;
    in property <bool> channel-processing;
    in property <int> channel-output-index;
    // A capture channel (Chat, Micro): its cards are CaptureCards, otherwise RenderCards.
    in property <bool> channel-capture;
    in property <PresetHeader> preset;
    // The tab's nine favourite slots.
    in property <[PresetTile]> favorites;
    in property <int> favorite-count;
    in property <RenderView> render;
    in property <CaptureView> capture;
    in property <[SpeakerView]> speakers;
    in property <[BandView]> eq-bands;
    in property <[MarkerView]> eq-markers;
    in property <string> eq-curve;
    // The open tab's equalizer shows a voice's zone labels.
    in property <bool> eq-voice-zones;
    // The header's "Tester" row: the open channel's test sounds (dimmed unless ready), or the
    // Micro tab's microphone test; the note says why they are dimmed or what went wrong.
    in property <[TestSample]> test-samples;
    in property <bool> test-ready;
    in property <string> test-note;
    in property <MicTest> mic-test;
    // The preset browser.
    in property <bool> browse-open;
    in property <string> browse-key;
    in property <string> browse-title;
    in property <int> browse-filter;
    in property <[int]> browse-counts;
    in property <[PresetTile]> browse-tiles;
    in property <bool> browse-full;
    in property <string> browse-note;
    // Gaming's browser offers the "Par jeu" filter.
    in property <bool> browse-games;
    // The preset per game (platinum.ini's game_presets) and GG's Arena 7 rule (arena_speakers),
    // and the user's links of Gaming's presets to programs, for the settings page.
    in property <bool> game-presets: true;
    in property <bool> arena-speakers: true;
    in property <[LinkRow]> game-links;
    // "Associer au jeu en cours…": the dialog, the preset it links and the programs offered.
    in-out property <bool> linking;
    in property <string> link-preset;
    in property <[RunningApp]> link-apps;
    // The name dialog: 0 closed, 1 new preset, 2 save as, 3 rename.
    in-out property <int> naming: 0;
    in property <string> naming-key;
    in property <string> naming-initial;
    // The settings page (page 6) and its section (Section); what waits for the daemon's next
    // start, in a sentence; when a change of each option takes effect (SettingId order).
    in-out property <int> settings-section: 0;
    in property <string> pending-restart;
    in property <[string]> setting-notes;
    // Its Général section: the Run value, Task Manager's switch, the install, the window's start,
    // the channels' names.
    in property <bool> start-on-open;
    in property <bool> start-with-windows;
    in property <bool> startup-blocked;
    in property <bool> installed;
    in property <bool> platinum-names: true;
    // Its language menu (Windows' language first, then each language in itself) and the choice.
    in property <[string]> languages;
    in property <int> language-index;
    // Its Micro and Sorties sections: the effects and the volume of the relayed microphone, the
    // fallback devices' menus, then the backup switch, the two priority lists, the devices each
    // can still take, and the microphone chosen in the Micro strip.
    in property <bool> mic-effects: true;
    in property <float> mic-gain: 1;
    in property <[string]> fallback-outputs;
    in property <int> fallback-output-index;
    in property <[string]> fallback-inputs;
    in property <int> fallback-input-index;
    in property <bool> auto-switch;
    in property <[PriorityRow]> output-priority;
    in property <[PriorityRow]> input-priority;
    in property <[string]> output-addable;
    in property <[string]> input-addable;
    in property <string> preferred-microphone;
    // Its Streaming à distance section: the field of the streaming outputs (the user's while he
    // types, filled when the section opens), what platinum.ini holds, and the default.
    in-out property <string> sinks-text;
    in property <string> sinks-saved;
    in property <string> sinks-default;
    // Its "À propos".
    in property <AboutView> about;
    // Its Raccourcis et superpositions section: the actions by group, the field waiting for a
    // combination, why the last one was refused, and the overlays' options.
    in property <[ShortcutGroup]> shortcut-groups;
    in-out property <int> shortcut-capturing: -1;
    in property <string> shortcut-note;
    in property <bool> shortcut-conflicts;
    in property <bool> overlays-on;
    in property <int> overlay-position;
    in property <[string]> overlay-positions;
    in property <bool> overlay-volume;
    in property <bool> overlay-mute;
    in property <bool> overlay-device;
    in property <bool> can-preview-overlay: true;
    // Layout check only: the strip whose preset menu opens (its tab number), the tab's "…" menu,
    // and the Master's output menu.
    in property <int> open-strip-menu: -1;
    in property <bool> open-preset-menu;
    in property <bool> open-master-menu;
    // How far the channel tab and the settings page are scrolled (negative when moved down); the
    // layout check sets them.
    in-out property <length> tab-scroll;
    in-out property <length> settings-scroll;
    // Daemon and messages
    in property <DaemonState> daemon;
    in property <[NoticeView]> notices;
    // The microphone's echo cancellation listens to other outputs than the channels play to.
    in property <bool> echo-stale;
    // The echo-cancellation card closed by the user for this session (it comes back next time).
    property <bool> echo-hidden;
    // The question on screen: 0 none, 1 stop the daemon, 2 change the microphone, 3 a Bluetooth
    // microphone refused, 4 delete the tab's preset, 5 reset it, 6 turn streamer mode on, 7 off,
    // 8 restart the daemon for the options it reads at start, 10 send the report of a crash
    // (crash_reports = ask), 11 delete every crash report.
    in-out property <int> asking: 0;
    // Crash reports: the settings page's section (the offer, the reports, where an issue goes, the
    // folder), the question after a crash (its sentence and the report's file name), and the send
    // dialog (open, the anonymised text, what its last button did).
    in property <bool> crash-ask;
    in property <[CrashRow]> crash-rows;
    in property <string> crash-repository;
    in property <bool> crash-repository-known;
    in property <string> crash-folder;
    in property <string> crash-question;
    in property <string> crash-question-name;
    in-out property <bool> crash-sending;
    in property <string> crash-text;
    in property <string> crash-note;
    // The microphone chosen, as the streamer strip shows it (its menu is in the Master then).
    property <string> microphone-name: root.mic-current >= 0 && root.mic-current < root.mic-inputs.length ? root.mic-inputs[root.mic-current] : @tr("Aucun micro choisi");
    // The microphone the confirmation is about, as it was named when picked.
    in-out property <string> asked-microphone-name;
    out property <bool> dragging: Drag.key != "";

    // Opens the daemon's popover (start, stop, options), as a click on the header's state does.
    public function open-daemon-popover() {
        daemon-control.open();
    }


    // A microphone picked in the Micro strip: refused when it is a Bluetooth headset's, confirmed
    // first when the daemon must restart for it (the sound cuts for a few seconds).
    function pick-microphone(index: int) {
        if (index == root.mic-current) {
            return;
        }
        if (index < root.mic-hands-free.length && root.mic-hands-free[index]) {
            root.asking = 3;
        } else if (root.daemon.restarts-on-mic-change) {
            // Rust keeps which device was picked: the list may change while the question is open.
            Backend.microphone-picked(index);
            root.asked-microphone-name = index < root.mic-inputs.length ? root.mic-inputs[index] : "";
            root.asking = 2;
        } else {
            Backend.choose-microphone(index);
        }
    }

    // Flipped by the window code when Windows needs every pixel drawn again (src/repaint.rs):
    // the rectangle under everything changes colour by one step of blue, which makes the whole
    // window dirty for the software renderer, so the next frame repaints and copies all of it.
    in property <bool> full-repaint;
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: root.full-repaint ? #0f1013 : Palette.base;
    }

    VerticalLayout {
        // header: mark, tabs, the daemon's state
        Rectangle {
            height: Geometry.top;
            background: Palette.base;
            HorizontalLayout {
                padding-left: Geometry.pad;
                padding-right: Geometry.pad;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 10px;
                    padding-right: 28px;
                    horizontal-stretch: 0;
                    Image {
                        width: 81px;
                        height: 54px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("logo-wide.png");
                        image-rendering: smooth;
                    }
                    Text {
                        text: "PLATINUM";
                        color: Palette.text;
                        font-size: 13px;
                        font-weight: 700;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                    }
                }
                for name[index] in [@tr("MIXEUR"), @tr("GAMING"), @tr("CHAT"), @tr("MEDIA"), @tr("AUX"), @tr("MICRO")]: Tab {
                    text: name;
                    active: root.page == index;
                    clicked => { Backend.open-page(index); }
                }
                Rectangle { }
                SettingsButton {
                    y: (parent.height - self.height) / 2;
                    active: root.page == 6;
                    clicked => { Backend.open-settings(root.settings-section); }
                }
                Rectangle {
                    width: 4px;
                }
                daemon-control := DaemonControl {
                    y: (parent.height - self.height) / 2;
                    daemon: root.daemon;
                    ask-stop => { root.asking = 1; }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Palette.hairline;
            }
        }

        // While the sound does not go through Platinum: why, and how to start it.
        if root.daemon.banner != "": Rectangle {
            height: 44px;
            background: root.daemon.banner-tone == 2 ? #f0565c18 : (root.daemon.banner-tone == 1 ? #f2c14e14 : #ffffff08);
            HorizontalLayout {
                padding-left: Geometry.pad;
                padding-right: Geometry.pad;
                spacing: 12px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    name: root.daemon.banner-tone != 0 ? "alert" : (root.daemon.phase == "running" && root.daemon.remote != "" ? "remote" : "power");
                    size: 18px;
                    tint: root.daemon.banner-tone == 2 ? Palette.hot : (root.daemon.banner-tone == 1 ? Palette.amber : Palette.dim);
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.daemon.banner;
                    color: root.daemon.banner-tone == 2 ? Palette.hot : (root.daemon.banner-tone == 1 ? Palette.amber : Palette.text);
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.daemon.can-start: Button {
                    y: (parent.height - self.height) / 2;
                    width: 120px;
                    horizontal-stretch: 0;
                    text: @tr("Démarrer");
                    primary: true;
                    clicked => { Backend.start-daemon(); }
                }
            }
        }

        // MIXER
        if root.page == 0: VerticalLayout {
            padding-top: 20px;
            padding-left: Geometry.pad;
            padding-right: Geometry.pad;
            padding-bottom: Geometry.pad;
            spacing: Geometry.gap;
            alignment: start;
            HorizontalLayout {
                spacing: Geometry.gap;
                alignment: center;
                // Streamer mode's Master: the two mixes' devices (GG's "Mix personnel", "Mix de
                // stream"), the Master of each mix, then the applications to route.
                if root.streamer: StripFrame {
                    width: Geometry.master-streamer;
                    icon: "master";
                    title: @tr("MASTER");
                    openable: false;
                    drop-index: 0;
                    takes-recording: true;
                    VerticalLayout {
                        spacing: 8px;
                        MixDevice {
                            caption: @tr("MIX PERSONNEL");
                            model: root.outputs;
                            current: root.personal-output-index;
                            placeholder: @tr("Aucune sortie");
                            open-request: root.open-master-menu;
                            action: @tr("Gestionnaire de périphériques");
                            level: root.master-level;
                            level-known: root.master-level-known;
                            level-muted: root.master-device-muted;
                            chosen(index) => { Backend.set-personal-output(index); }
                            act => { Backend.open-settings(Section.outputs); }
                            level-moved(value) => { Backend.set-device-level(value); }
                        }
                        MixDevice {
                            caption: @tr("MIX DE STREAM");
                            model: root.stream-outputs;
                            current: root.stream-output-index;
                            placeholder: @tr("Aucune sortie");
                            level: root.stream-level;
                            level-known: root.stream-level-known;
                            level-muted: root.stream-device-muted;
                            chosen(index) => { Backend.set-stream-output(index); }
                            level-moved(value) => { Backend.set-stream-level(value); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        MixColumn {
                            width: 111px;
                            dot: false;
                            icon: "master";
                            value: root.master-volume;
                            muted: root.master-muted;
                            enabled: root.master-ready;
                            level: root.levels.length > 0 ? root.levels[0] : 0;
                            moved(value) => { Backend.set-master-volume(value); }
                            mute-clicked => { Backend.set-master-muted(!root.master-muted); }
                        }
                        MixColumn {
                            width: 111px;
                            dot: false;
                            icon: "broadcast";
                            value: root.stream-master-volume;
                            muted: root.stream-master-muted;
                            enabled: root.master-ready;
                            level: root.levels.length > 6 ? root.levels[6] : 0;
                            moved(value) => { Backend.set-stream-master-volume(value); }
                            mute-clicked => { Backend.set-stream-master-muted(!root.stream-master-muted); }
                        }
                    }
                    AppsBox {
                        apps: root.master-apps;
                        strip: 0;
                        caption: @tr("À TRANSFÉRER");
                        drop-hint: root.master-drop-hint;
                        action: @tr("Windows…");
                        act => { Backend.open-app-volume(); }
                    }
                }
                if !root.streamer: StripFrame {
                    width: Geometry.master;
                    icon: "master";
                    title: @tr("MASTER");
                    openable: false;
                    drop-index: 0;
                    takes-recording: true;
                    HorizontalLayout {
                        height: 24px;
                        spacing: 6px;
                        Label {
                            text: @tr("SORTIE DES CANAUX");
                            vertical-alignment: center;
                        }
                        Rectangle { }
                        Label {
                            width: 52px;
                            text: @tr("NIVEAU");
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Select {
                            model: root.outputs;
                            current: root.master-output-index;
                            placeholder: root.master-output-index < 0 ? @tr("Plusieurs sorties") : "—";
                            open-request: root.open-master-menu;
                            action: @tr("Gestionnaire de périphériques");
                            action-icon: "devices";
                            chosen(index) => { Backend.set-master-output(index); }
                            act => { Backend.open-settings(Section.outputs); }
                        }
                        // The Windows volume of the real device the channels play to.
                        LevelBox {
                            value: root.master-level;
                            known: root.master-level-known;
                            muted: root.master-device-muted;
                            moved(value) => { Backend.set-device-level(value); }
                        }
                    }
                    HorizontalLayout {
                        height: 230px;
                        alignment: center;
                        spacing: 12px;
                        Meter {
                            level: root.levels.length > 0 ? root.levels[0] : 0;
                        }
                        Fader {
                            value: root.master-volume;
                            dimmed: root.master-muted;
                            enabled: root.master-ready;
                            moved(value) => { Backend.set-master-volume(value); }
                        }
                    }
                    VolumeRow {
                        value: root.master-volume;
                        muted: root.master-muted;
                        enabled: root.master-ready;
                        mute-clicked => { Backend.set-master-muted(!root.master-muted); }
                        moved(value) => { Backend.set-master-volume(value); }
                    }
                    AppsBox {
                        apps: root.master-apps;
                        strip: 0;
                        caption: @tr("À TRANSFÉRER");
                        drop-hint: root.master-drop-hint;
                        action: @tr("Windows…");
                        act => { Backend.open-app-volume(); }
                    }
                }
                for column[index] in root.columns: Strip {
                    width: Geometry.strip;
                    column: column;
                    index: index + 1;
                    open-request: root.open-strip-menu;
                    level: index + 1 < root.levels.length ? root.levels[index + 1] : 0;
                    outputs: root.outputs;
                    streamer: root.streamer;
                }
                Rectangle {
                    width: 1px;
                    background: Palette.hairline;
                }
                StripFrame {
                    width: Geometry.strip;
                    icon: "mic";
                    title: @tr("MICRO");
                    drop-index: 5;
                    takes-playing: false;
                    takes-recording: true;
                    open => { Backend.open-page(5); }
                    PresetRow {
                        column: root.mic;
                        page: 5;
                        open-request: root.open-strip-menu;
                    }
                    // The real microphone the daemon relays into the virtual one. In streamer mode
                    // its menu is the Master's "Entrée micro", as in GG; the strip names it.
                    if !root.streamer: Select {
                        model: root.mic-inputs;
                        current: root.mic-current;
                        placeholder: @tr("Aucun micro choisi");
                        action: @tr("Gestionnaire de périphériques");
                        action-icon: "devices";
                        chosen(index) => { root.pick-microphone(index); }
                        act => { Backend.open-settings(Section.microphone); }
                    }
                    if root.streamer: Rectangle {
                        height: 30px;
                        border-radius: 4px;
                        background: Palette.well;
                        border-width: 1px;
                        border-color: Palette.hairline;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                name: "mic";
                                size: 14px;
                                tint: Palette.faint;
                            }
                            Text {
                                text: root.microphone-name;
                                color: Palette.dim;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    HorizontalLayout {
                        height: 230px;
                        alignment: center;
                        spacing: 12px;
                        Meter {
                            level: root.levels.length > 5 ? root.levels[5] : 0;
                        }
                        // The virtual microphone's Windows volume: what Discord and the others record.
                        Fader {
                            value: root.mic-volume;
                            dimmed: root.mic-muted;
                            enabled: root.mic-volume-known;
                            moved(value) => { Backend.set-mic-volume(value); }
                        }
                    }
                    VolumeRow {
                        value: root.mic-volume;
                        known: root.mic-volume-known;
                        muted: root.mic-muted;
                        mute-clicked => { Backend.set-mic-muted(!root.mic-muted); }
                        moved(value) => { Backend.set-mic-volume(value); }
                    }
                    // The applications that record Microphone (Platinum); one that records a real
                    // microphone is listed under the Master and can be dropped here.
                    AppsBox {
                        apps: root.mic-apps;
                        strip: 5;
                        drop-hint: @tr("Déposer ici : enregistre Microphone (Platinum)");
                        empty: root.mic-volume-known
                            ? @tr("Aucune application n'enregistre Microphone (Platinum) en ce moment.")
                            : @tr("Microphone (Platinum) n'est pas actif : démarrez Platinum.");
                    }
                }
            }
            // ChatMix, under Gaming and Chat; in streamer mode, the Master's microphone input under
            // the Master (GG's "Entrée micro").
            HorizontalLayout {
                alignment: center;
                if !root.streamer: Rectangle {
                    width: Geometry.master + Geometry.gap;
                }
                if root.streamer: Rectangle {
                    width: Geometry.master-streamer;
                    height: 52px;
                    border-radius: 6px;
                    background: Palette.panel;
                    border-width: 1px;
                    border-color: Palette.hairline;
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 14px;
                        padding-bottom: 10px;
                        MixDevice {
                            caption: @tr("ENTRÉE MICRO");
                            has-level: false;
                            model: root.mic-inputs;
                            current: root.mic-current;
                            placeholder: @tr("Aucun micro choisi");
                            action: @tr("Gestionnaire de périphériques");
                            chosen(index) => { root.pick-microphone(index); }
                            act => { Backend.open-settings(Section.microphone); }
                        }
                    }
                }
                if root.streamer: Rectangle {
                    width: Geometry.gap;
                }
                Rectangle {
                    width: 2 * Geometry.strip + Geometry.gap;
                    height: root.chatmix-reason == "" ? 52px : 74px;
                    border-radius: 6px;
                    background: Palette.panel;
                    border-width: 1px;
                    border-color: Palette.hairline;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            name: "game";
                            size: 16px;
                            tint: root.chatmix < -0.02 ? Palette.text : Palette.dim;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Label {
                                text: @tr("CHATMIX");
                                horizontal-alignment: center;
                            }
                            Balance {
                                value: root.chatmix;
                                enabled: root.chatmix-ready;
                                moved(value) => { Backend.set-chatmix(value); }
                            }
                            if root.chatmix-reason != "": Text {
                                text: root.chatmix-reason;
                                color: Palette.faint;
                                font-size: 10px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                        Icon {
                            y: (parent.height - self.height) / 2;
                            name: "chat";
                            size: 16px;
                            tint: root.chatmix > 0.02 ? Palette.text : Palette.dim;
                        }
                    }
                }
                Rectangle {
                    width: 3 * Geometry.strip + 4 * Geometry.gap + 1px;
                }
            }
        }

        // CHANNEL TABS
        if root.page > 0 && root.page < 6: VerticalLayout {
            padding-top: 20px;
            padding-left: Geometry.pad;
            padding-right: Geometry.pad;
            spacing: 14px;
            // GG's ConfigVADHeader: the channel, its current preset, Parcourir and the favourites;
            // then Platinum's "Effets" switch and the channel's output; last, GG's audio test
            // (the microphone test on Micro). Without a test row (Chat: no spatial audio), the
            // header keeps only its two rows.
            Rectangle {
                height: root.page == 5 || root.test-samples.length > 0 ? 156px : 116px;
                border-radius: 6px;
                background: Palette.panel;
                border-width: 1px;
                border-color: Palette.hairline;
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 10px;
                    padding-bottom: 12px;
                    spacing: 10px;
                    HorizontalLayout {
                        height: 48px;
                        spacing: 14px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            name: root.page == 5 ? root.mic.icon : (root.page - 1 < root.columns.length ? root.columns[root.page - 1].icon : "");
                            size: 26px;
                            tint: Palette.text;
                        }
                        Text {
                            min-width: 96px;
                            text: root.page == 5 ? @tr("MICRO") : (root.page - 1 < root.columns.length ? root.columns[root.page - 1].title : "");
                            color: Palette.text;
                            font-size: 18px;
                            font-weight: 700;
                            letter-spacing: 2px;
                            vertical-alignment: center;
                        }
                        CurrentPreset {
                            y: (parent.height - self.height) / 2;
                            key: root.channel-key;
                            preset: root.preset;
                            open-request: root.open-preset-menu;
                            ask(question) => { root.asking = question; }
                        }
                        Button {
                            y: (parent.height - self.height) / 2;
                            text: @tr("Parcourir");
                            enabled: root.preset.ready;
                            clicked => { Backend.open-browse(root.channel-key); }
                        }
                        Rectangle { }
                        Label {
                            text: @tr("EFFETS DU CANAL");
                            vertical-alignment: center;
                        }
                        Toggle {
                            y: (parent.height - self.height) / 2;
                            on: root.channel-processing && root.channel-readable;
                            enabled: root.channel-readable;
                            toggled(on) => { Backend.edit(root.channel-key, Field.global-enable, on ? 1 : 0); }
                        }
                        Rectangle {
                            width: 6px;
                        }
                        if root.page != 5 && !root.streamer: Label {
                            text: @tr("SORTIE");
                            vertical-alignment: center;
                        }
                        if root.page != 5 && !root.streamer: Select {
                            width: 230px;
                            y: (parent.height - self.height) / 2;
                            model: root.outputs;
                            current: root.channel-readable ? root.channel-output-index : -1;
                            enabled: root.channel-readable;
                            chosen(index) => { Backend.set-output(root.channel-key, index); }
                        }
                        // Streamer mode: GG's "Ajouter à" checkboxes; the devices are the mixes'.
                        if root.page != 5 && root.streamer: Label {
                            text: @tr("MIX PERSONNEL");
                            vertical-alignment: center;
                        }
                        if root.page != 5 && root.streamer: Toggle {
                            y: (parent.height - self.height) / 2;
                            on: root.page - 1 < root.columns.length && root.columns[root.page - 1].in-personal;
                            enabled: root.channel-readable;
                            toggled(on) => { Backend.set-inclusion(root.channel-key, 0, on); }
                        }
                        if root.page != 5 && root.streamer: Rectangle {
                            width: 6px;
                        }
                        if root.page != 5 && root.streamer: Label {
                            text: @tr("MIX DE STREAM");
                            vertical-alignment: center;
                        }
                        if root.page != 5 && root.streamer: Toggle {
                            y: (parent.height - self.height) / 2;
                            on: root.page - 1 < root.columns.length && root.columns[root.page - 1].in-stream;
                            enabled: root.channel-readable;
                            toggled(on) => { Backend.set-inclusion(root.channel-key, 1, on); }
                        }
                        if root.page == 5: Text {
                            max-width: 260px;
                            text: root.mic-current >= 0 && root.mic-current < root.mic-inputs.length ? root.mic-inputs[root.mic-current] : @tr("Aucun micro choisi");
                            color: Palette.dim;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    FavoritesBar {
                        height: 32px;
                        key: root.channel-key;
                        slots: root.favorites;
                        count: root.favorite-count;
                        enabled: root.preset.ready;
                    }
                    // Chat has no spatial audio, hence no test sound: no empty TESTER row either.
                    if root.page != 5 && root.test-samples.length > 0: HorizontalLayout {
                        height: 30px;
                        TestBar {
                            key: root.channel-key;
                            samples: root.test-samples;
                            ready: root.test-ready;
                            note: root.test-note;
                        }
                    }
                    if root.page == 5: MicTestBar {
                        height: 30px;
                        test: root.mic-test;
                        note: root.test-note;
                    }
                }
            }
            if !root.channel-readable: Rectangle {
                height: 120px;
                border-radius: 6px;
                background: Palette.panel;
                border-width: 1px;
                border-color: Palette.hairline;
                HorizontalLayout {
                    padding: 24px;
                    spacing: 16px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        name: "alert";
                        size: 24px;
                        tint: Palette.amber;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: @tr("Réglages de ce canal illisibles");
                            color: Palette.text;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        Text {
                            text: @tr("Le module audio de SteelSeries ne répond pas pour ce canal. Ses réglages ne sont pas affichés plutôt que d'en montrer de faux ; la fenêtre réessaie toutes les 30 secondes.");
                            color: Palette.dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            if root.channel-readable: ScrollView {
                content-y <=> root.tab-scroll;
                VerticalLayout {
                    padding-bottom: Geometry.pad;
                    alignment: start;
                    if !root.channel-capture: RenderCards {
                        key: root.channel-key;
                        view: root.render;
                        voice-zones: root.eq-voice-zones;
                        bands: root.eq-bands;
                        markers: root.eq-markers;
                        curve: root.eq-curve;
                        speakers: root.speakers;
                    }
                    if root.channel-capture: CaptureCards {
                        key: root.channel-key;
                        view: root.capture;
                        voice-zones: root.eq-voice-zones;
                        bands: root.eq-bands;
                        curve: root.eq-curve;
                    }
                }
            }
        }

        // SETTINGS
        if root.page == 6: SettingsPage {
            section <=> root.settings-section;
            scroll <=> root.settings-scroll;
            daemon-running: root.daemon.can-stop;
            pending: root.pending-restart;
            notes: root.setting-notes;
            start-with-windows: root.start-with-windows;
            startup-blocked: root.startup-blocked;
            installed: root.installed;
            start-on-open: root.start-on-open;
            platinum-names: root.platinum-names;
            languages: root.languages;
            language-index: root.language-index;
            mic-inputs: root.mic-inputs;
            mic-current: root.mic-current;
            mic-effects: root.mic-effects;
            mic-gain: root.mic-gain;
            fallback-inputs: root.fallback-inputs;
            fallback-input-index: root.fallback-input-index;
            input-priority: root.input-priority;
            input-addable: root.input-addable;
            preferred-microphone: root.preferred-microphone;
            auto-switch: root.auto-switch;
            output-priority: root.output-priority;
            output-addable: root.output-addable;
            fallback-outputs: root.fallback-outputs;
            fallback-output-index: root.fallback-output-index;
            streamer: root.streamer;
            follow-streaming: root.follow-streaming;
            route-apps: root.route-apps;
            sinks-text <=> root.sinks-text;
            sinks-saved: root.sinks-saved;
            sinks-default: root.sinks-default;
            game-presets: root.game-presets;
            arena-speakers: root.arena-speakers;
            links: root.game-links;
            shortcut-groups: root.shortcut-groups;
            shortcut-capturing <=> root.shortcut-capturing;
            shortcut-note: root.shortcut-note;
            shortcut-conflicts: root.shortcut-conflicts;
            overlays-on: root.overlays-on;
            overlay-position: root.overlay-position;
            overlay-positions: root.overlay-positions;
            overlay-volume: root.overlay-volume;
            overlay-mute: root.overlay-mute;
            overlay-device: root.overlay-device;
            can-preview-overlay: root.can-preview-overlay;
            crash-ask: root.crash-ask;
            crash-rows: root.crash-rows;
            crash-repository: root.crash-repository;
            crash-repository-known: root.crash-repository-known;
            crash-folder: root.crash-folder;
            about: root.about;
            pick-microphone(index) => { root.pick-microphone(index); }
            ask(question) => { root.asking = question; }
        }
    }

    // the explanation of the pill under the pointer
    if Hint.text != "" && Drag.key == "": Rectangle {
        x: min(Hint.x, root.width - self.width - 8px);
        y: Hint.y;
        width: 280px;
        height: hint-text.preferred-height + 16px;
        border-radius: 4px;
        background: Palette.raised;
        border-width: 1px;
        border-color: Palette.edge;
        drop-shadow-blur: 12px;
        drop-shadow-color: #000000c0;
        hint-text := Text {
            x: 8px;
            width: parent.width - 16px;
            height: parent.height;
            text: Hint.text;
            color: Palette.text;
            font-size: 11px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }

    // the application being dragged
    if Drag.key != "": Rectangle {
        x: Drag.x - 60px;
        y: Drag.y - 12px;
        width: 120px;
        height: 24px;
        border-radius: 3px;
        background: Palette.light;
        drop-shadow-blur: 12px;
        drop-shadow-color: #000000c0;
        Text {
            width: parent.width;
            height: parent.height;
            text: Drag.name;
            color: Palette.base;
            font-size: 11px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Notifications, newest at the bottom, each kept until closed; the echo cancellation's state
    // under them, with the action that sets it right, while it lasts.
    if root.notices.length > 0 || (root.echo-stale && !root.echo-hidden): VerticalLayout {
        x: root.width - self.width - 16px;
        y: root.height - self.height - 16px;
        width: 420px;
        height: self.preferred-height;
        spacing: 8px;
        for notice in root.notices: Rectangle {
            background: Palette.raised;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.edge;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000c0;
            HorizontalLayout {
                padding: 12px;
                spacing: 10px;
                Icon {
                    name: "alert";
                    size: 16px;
                    tint: Palette.amber;
                }
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: notice.text;
                        color: Palette.text;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if notice.detail != "": Text {
                        text: notice.detail;
                        color: Palette.dim;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                IconButton {
                    width: 24px;
                    height: 24px;
                    icon: "close";
                    clicked => { Backend.dismiss(notice.id); }
                }
            }
        }
        if root.echo-stale && !root.echo-hidden: Rectangle {
            background: Palette.raised;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.amber;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000c0;
            HorizontalLayout {
                padding: 12px;
                spacing: 10px;
                Icon {
                    name: "alert";
                    size: 16px;
                    tint: Palette.amber;
                }
                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("L'annulation d'écho écoute une autre sortie");
                        color: Palette.text;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Vos correspondants peuvent entendre vos haut-parleurs.");
                        color: Palette.dim;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: @tr("Mettre à jour l'annulation d'écho");
                            primary: true;
                            clicked => { Backend.sync-echo(); }
                        }
                    }
                }
                IconButton {
                    width: 24px;
                    height: 24px;
                    icon: "close";
                    clicked => { root.echo-hidden = true; }
                }
            }
        }
    }

    if root.asking == 1: Dialog {
        title: @tr("Arrêter Platinum ?");
        text: @tr("Le son et le micro passeront directement par Windows, sans les effets de Platinum, jusqu'à ce que vous redémarriez Platinum. Discord et les autres applications n'entendront plus le micro virtuel.");
        confirm: @tr("Arrêter");
        confirmed => {
            root.asking = 0;
            Backend.stop-daemon();
        }
        cancelled => { root.asking = 0; }
    }
    if root.asking == 2: Dialog {
        title: @tr("Changer de micro ?");
        text: root.asked-microphone-name != "" ? @tr("Platinum redémarre pour ouvrir {} : le son et le micro sont coupés quelques secondes.", root.asked-microphone-name) : @tr("Platinum redémarre pour ouvrir ce micro : le son et le micro sont coupés quelques secondes.");
        confirm: @tr("Changer de micro");
        confirmed => {
            root.asking = 0;
            Backend.confirm-microphone();
        }
        cancelled => { root.asking = 0; }
    }
    if root.asking == 3: Dialog {
        title: @tr("Micro d'un casque Bluetooth");
        text: @tr("Ouvrir ce micro ferait passer le casque en mode mains libres : la musique et les appels perdraient en qualité. Platinum ne l'utilise pas ; branchez un autre micro ou choisissez-en un autre dans la liste.");
        cancel: @tr("Fermer");
        cancelled => { root.asking = 0; }
    }
    if root.asking == 4: Dialog {
        title: @tr("Voulez-vous vraiment supprimer ?");
        text: @tr("Le préréglage « {} » sera supprimé : vous perdrez tous les paramètres appliqués à cette configuration. Le canal garde ses réglages actuels.", root.preset.name);
        confirm: @tr("Supprimer");
        confirmed => {
            root.asking = 0;
            Backend.delete-preset(root.channel-key);
        }
        cancelled => { root.asking = 0; }
    }
    if root.asking == 6: Dialog {
        title: @tr("Activer le mode streamer ?");
        text: @tr("Chaque canal aura deux volumes : celui du mix personnel, que vous entendez, et celui du mix de stream, envoyé vers Stream (Platinum) pour vos logiciels de streaming (OBS, Streamlabs…). Les canaux du mix personnel joueront tous sur la même sortie ; Platinum retient leurs sorties actuelles et les remettra en revenant au mode classique.");
        confirm: @tr("Activer");
        confirmed => {
            root.asking = 0;
            Backend.set-streamer(true);
        }
        cancelled => { root.asking = 0; }
    }
    if root.asking == 7: Dialog {
        title: @tr("Revenir au mode classique ?");
        text: @tr("Plus aucun canal n'est envoyé vers le mix de stream, et chaque canal retrouve la sortie qu'il avait en mode classique. Vos choix de canaux pour les deux mix sont gardés pour la prochaine fois.");
        confirm: @tr("Revenir au mode classique");
        confirmed => {
            root.asking = 0;
            Backend.set-streamer(false);
        }
        cancelled => { root.asking = 0; }
    }
    if root.asking == 8: Dialog {
        title: @tr("Redémarrer Platinum ?");
        text: @tr("Platinum s'arrête puis redémarre avec vos nouveaux réglages : le son et le micro sont coupés quelques secondes. Discord et les autres applications n'entendent plus le micro pendant ce temps.");
        confirm: @tr("Redémarrer");
        confirmed => {
            root.asking = 0;
            Backend.restart-daemon();
        }
        cancelled => { root.asking = 0; }
    }
    if root.asking == 10: Dialog {
        title: @tr("Platinum s'est arrêté brusquement");
        text: root.crash-question;
        confirm: @tr("Voir le rapport…");
        cancel: @tr("Plus tard");
        extra: @tr("Ne plus demander");
        confirmed => {
            root.asking = 0;
            Backend.crash-send(root.crash-question-name);
        }
        cancelled => { root.asking = 0; }
        extra-clicked => {
            root.asking = 0;
            Backend.crash-never-ask();
        }
    }
    if root.asking == 11: Dialog {
        title: @tr("Effacer les rapports de plantage ?");
        text: @tr("Les rapports de plantage enregistrés sur ce PC, et leurs fichiers de vidage, seront supprimés définitivement.");
        confirm: @tr("Tout effacer");
        confirmed => {
            root.asking = 0;
            Backend.crash-clear();
        }
        cancelled => { root.asking = 0; }
    }
    if root.crash-sending: ReportDialog {
        report: root.crash-text;
        repository: root.crash-repository;
        repository-known: root.crash-repository-known;
        note: root.crash-note;
        closed => { root.crash-sending = false; }
    }
    if root.asking == 5: Dialog {
        title: @tr("Voulez-vous vraiment réinitialiser ?");
        text: @tr("Tout paramètre appliqué à « {} » sera réinitialisé à la valeur par défaut.", root.preset.name);
        confirm: @tr("Réinitialiser");
        confirmed => {
            root.asking = 0;
            Backend.preset-command(root.channel-key, "reset");
        }
        cancelled => { root.asking = 0; }
    }

    if root.browse-open: BrowseOverlay {
        key: root.browse-key;
        title: root.browse-title;
        filter: root.browse-filter;
        counts: root.browse-counts;
        tiles: root.browse-tiles;
        favorites-full: root.browse-full;
        note: root.browse-note;
        games: root.browse-games;
    }
    if root.linking: LinkDialog {
        preset: root.link-preset;
        apps: root.link-apps;
        closed => { root.linking = false; }
    }
    if root.naming > 0: NameDialog {
        key: root.naming-key;
        purpose: root.naming;
        initial: root.naming-initial;
        closed => { root.naming = 0; }
    }
}
