// Line icons drawn for Platinum, on a 24 × 24 grid with a 1.6 stroke.

export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: #e9eaec;
    in property <length> size: 18px;
    // Filled with the tint (the star of a favourite).
    in property <bool> filled;
    // Filled without the outline: shapes that must keep their gaps at small sizes (the transport
    // shapes: pause's two bars would merge under the stroke).
    in property <bool> solid;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.solid ? transparent : root.tint;
    stroke-width: 1.6px;
    stroke-line-cap: round;
    fill: root.filled || root.solid ? root.tint : transparent;
    commands: root.name == "game" ? "M7.5 8.5h9a4.5 4.5 0 0 1 4.4 5.5l-.6 2.6a2.4 2.4 0 0 1-4.2 1L14.6 16H9.4l-1.5 1.6a2.4 2.4 0 0 1-4.2-1L3.1 14a4.5 4.5 0 0 1 4.4-5.5Z M8 11v3 M6.5 12.5h3 M15.5 11.6h.01 M17.5 13.4h.01"
        : root.name == "chat" ? "M4 15v-3a8 8 0 0 1 16 0v3 M4 14.5h2.5a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1Z M20 14.5h-2.5a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1H19a1 1 0 0 0 1-1Z M18.5 19.5c0 1.2-1.2 2-2.6 2H13"
        : root.name == "media" ? "M9 17.5V6.2l10-2.2v11.2 M9 17.5a2.5 2.5 0 1 1-5 0a2.5 2.5 0 0 1 5 0Z M19 15.2a2.5 2.5 0 1 1-5 0a2.5 2.5 0 0 1 5 0Z M9 9.6l10-2.2"
        : root.name == "aux" ? "M3 12h2.5l2-5.5 3.5 11 3-8 2 4.5H21"
        : root.name == "mic" ? "M12 3.5a3 3 0 0 0-3 3V12a3 3 0 0 0 6 0V6.5a3 3 0 0 0-3-3Z M18.5 11.5a6.5 6.5 0 0 1-13 0 M12 18v3 M9 21h6"
        : root.name == "master" ? "M3.5 15v-2.5a8.5 8.5 0 0 1 17 0V15 M3.5 14h3a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1Z M20.5 14h-3a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1Z"
        : root.name == "speaker" ? "M11 5.5 6.8 9H4v6h2.8l4.2 3.5Z M15 9.2a4 4 0 0 1 0 5.6 M17.8 6.6a7.6 7.6 0 0 1 0 10.8"
        : root.name == "muted" ? "M11 5.5 6.8 9H4v6h2.8l4.2 3.5Z M15.5 9.5l5 5 M20.5 9.5l-5 5"
        : root.name == "apps" ? "M4 4h6.5v6.5H4Z M13.5 4H20v6.5h-6.5Z M4 13.5h6.5V20H4Z M13.5 13.5H20V20h-6.5Z"
        : root.name == "settings" ? "M4 7h8 M16 7h4 M14 5v4 M4 17h3 M11 17h9 M9 15v4 M4 12h12 M20 12h0"
        : root.name == "mixer" ? "M6 4v16 M12 4v16 M18 4v16 M4 14h4 M10 8h4 M16 16h4"
        : root.name == "power" ? "M12 3.5v8 M17.3 6.4a7.5 7.5 0 1 1-10.6 0"
        : root.name == "chevron" ? "M7 10l5 5 5-5"
        : root.name == "check" ? "M5 12.5l4.5 4.5L19 7.5"
        : root.name == "eq" ? "M3 15c3 0 3-6 6-6s3 8 6 8 3-5 6-5"
        : root.name == "close" ? "M7 7l10 10 M17 7 7 17"
        : root.name == "alert" ? "M12 4.5 21 19.5H3Z M12 10v4.5 M12 17.2h.01"
        : root.name == "star" ? "M12 3.8l2.5 5.1 5.6.8-4.05 3.95.95 5.6L12 16.6l-5 2.65.95-5.6L3.9 9.7l5.6-.8Z"
        : root.name == "more" ? "M4.5 12a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0-2.8 0Z M10.6 12a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0-2.8 0Z M16.7 12a1.4 1.4 0 1 0 2.8 0a1.4 1.4 0 1 0-2.8 0Z"
        : root.name == "search" ? "M10.5 4.5a6 6 0 1 0 0 12a6 6 0 1 0 0-12Z M15 15l5 5"
        : root.name == "plus" ? "M12 5v14 M5 12h14"
        : root.name == "browse" ? "M4 5.5h16 M4 12h16 M4 18.5h10"
        : root.name == "reset" ? "M5.5 12a6.5 6.5 0 1 0 1.9-4.6 M5.5 4.5v3.5H9"
        : root.name == "info" ? "M12 3.8a8.2 8.2 0 1 0 0 16.4a8.2 8.2 0 1 0 0-16.4Z M12 11v5.2 M12 7.9h.01"
        : root.name == "help" ? "M12 3.8a8.2 8.2 0 1 0 0 16.4a8.2 8.2 0 1 0 0-16.4Z M9.6 9.6a2.5 2.5 0 1 1 3.6 2.2c-.8.4-1.2 1-1.2 1.8v.6 M12 16.6h.01"
        : root.name == "trash" ? "M5 7h14 M9.5 7V4.8h5V7 M7 7l.8 12.2h8.4L17 7 M10.4 10.5v5.5 M13.6 10.5v5.5"
        : root.name == "up" ? "M7 14l5-5 5 5"
        : root.name == "down" ? "M7 10l5 5 5-5"
        : root.name == "keyboard" ? "M3.5 6.5h17a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-17a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1Z M6.5 10h.01 M9.5 10h.01 M12.5 10h.01 M15.5 10h.01 M18 10h.01 M7.5 14h9"
        : root.name == "devices" ?"M4 5.5h10v8H4Z M7 17h4 M9 13.5V17 M16.5 8.5h3.5v10h-3.5Z M18.25 15.6h.01"
        : root.name == "remote" ? "M3.5 4.5h17v11h-17Z M8.5 19.5h7 M12 15.5v4 M10.5 7.6v4.8l4-2.4Z"
        : root.name == "broadcast" ?"M12 11a1.2 1.2 0 1 0 0 2.4a1.2 1.2 0 1 0 0-2.4Z M8.6 8.6a4.8 4.8 0 0 0 0 6.8 M15.4 8.6a4.8 4.8 0 0 1 0 6.8 M5.7 5.7a8.9 8.9 0 0 0 0 12.6 M18.3 5.7a8.9 8.9 0 0 1 0 12.6"
        // The transport shapes (test sounds, microphone test), drawn `solid`.
        : root.name == "play" ? "M6.5 4.6v14.8a.9.9 0 0 0 1.37.77l11.8-7.4a.9.9 0 0 0 0-1.54L7.87 3.83a.9.9 0 0 0-1.37.77Z"
        : root.name == "pause" ? "M5.5 4.5h4.5v15H5.5Z M14 4.5h4.5v15H14Z"
        : root.name == "record" ? "M12 5a7 7 0 1 0 0 14a7 7 0 1 0 0-14Z"
        : root.name == "stop" ? "M5.5 5.5h13v13h-13Z"
        : "";
}
