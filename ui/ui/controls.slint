// Platinum's controls: a mixing-desk look, graphite and brushed metal, one light for "on",
// green-amber-red only where a level is measured.

import { Icon } from "icons.slint";

export global Palette {
    out property <color> base: #0f1012;
    out property <color> panel: #16171a;
    out property <color> raised: #1d1e22;
    out property <color> well: #0b0c0d;
    out property <color> hairline: #26282c;
    out property <color> edge: #33363b;
    out property <color> text: #ebecee;
    out property <color> dim: #9b9ea5;
    out property <color> faint: #63666d;
    out property <color> light: #e9ecf1;
    out property <color> metal-top: #f3f4f6;
    out property <color> metal-bottom: #a9aeb6;
    out property <color> signal: #9ee06a;
    out property <color> amber: #f2c14e;
    out property <color> hot: #f0565c;
}

// Small capitals used for labels.
export component Label inherits Text {
    color: Palette.faint;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.2px;
}

// A vertical segmented level meter, 0..1.
export component Meter inherits Rectangle {
    in property <float> level;
    in property <int> segments: 32;
    width: 6px;
    for i in root.segments: Rectangle {
        property <float> position: (i + 1) / root.segments;
        x: 0;
        width: root.width;
        height: (root.height - (root.segments - 1) * 2px) / root.segments;
        y: root.height - (i + 1) * (self.height + 2px) + 2px;
        border-radius: 1px;
        background: root.level >= self.position - 0.5 / root.segments
            ? (self.position > 0.92 ? Palette.hot : (self.position > 0.75 ? Palette.amber : Palette.signal))
            : #ffffff0c;
    }
}

// The same meter lying down, filling from the left (the microphone test's level).
export component LevelBar inherits Rectangle {
    in property <float> level;
    in property <int> segments: 24;
    height: 8px;
    for i in root.segments: Rectangle {
        property <float> position: (i + 1) / root.segments;
        x: i * (self.width + 2px);
        y: 0;
        width: (root.width - (root.segments - 1) * 2px) / root.segments;
        height: root.height;
        border-radius: 1px;
        background: root.level >= self.position - 0.5 / root.segments
            ? (self.position > 0.92 ? Palette.hot : (self.position > 0.75 ? Palette.amber : Palette.signal))
            : #ffffff0c;
    }
}

// A long-throw fader: groove, scale, metal cap. Reports positions 0..1.
export component Fader inherits Rectangle {
    in property <float> value;
    in property <bool> dimmed;
    in property <bool> enabled: true;
    callback moved(float);
    opacity: root.enabled ? 1 : 0.35;
    width: 44px;
    property <length> cap: 30px;
    property <length> travel: root.height - root.cap;

    function set-from(y: length) {
        root.moved(max(0, min(1, 1 - (y - root.cap / 2) / root.travel)));
    }

    // scale
    for i in 11: Rectangle {
        x: i == 0 || i == 5 || i == 10 ? 2px : 6px;
        y: root.cap / 2 + root.travel * (1 - i / 10) - 0.5px;
        width: i == 0 || i == 5 || i == 10 ? 9px : 5px;
        height: 1px;
        background: Palette.edge;
    }
    // groove
    Rectangle {
        x: (root.width - self.width) / 2 + 4px;
        y: root.cap / 2 - 2px;
        width: 4px;
        height: root.travel + 4px;
        border-radius: 2px;
        background: Palette.well;
        border-width: 1px;
        border-color: #00000080;
    }
    // cap
    Rectangle {
        x: (root.width - self.width) / 2 + 4px;
        y: root.travel * (1 - root.value);
        width: 24px;
        height: root.cap;
        border-radius: 3px;
        background: root.dimmed ? @linear-gradient(180deg, #8d9198 0%, #5d6168 100%) : @linear-gradient(180deg, Palette.metal-top 0%, Palette.metal-bottom 100%);
        drop-shadow-blur: 6px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #000000b0;
        Rectangle {
            y: (parent.height - 2px) / 2;
            x: 3px;
            width: parent.width - 6px;
            height: 2px;
            background: #1b1c1f;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.set-from(self.mouse-y);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-y);
            }
        }
        scroll-event(event) => {
            root.moved(max(0, min(1, root.value + (event.delta-y > 0 ? 0.02 : -0.02))));
            return accept;
        }
    }
}

// An on/off switch. Controlled: it shows `on` and asks for the change through `toggled`; the
// owner of the value changes it (assigning it here would cut the binding to the model).
export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    opacity: root.enabled ? 1 : 0.35;
    width: 32px;
    height: 18px;
    border-radius: 9px;
    background: root.on ? Palette.light : transparent;
    border-width: 1px;
    border-color: root.on ? Palette.light : Palette.edge;
    animate background { duration: 120ms; }
    Rectangle {
        x: root.on ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.on ? Palette.base : Palette.dim;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

// A rotary control over 270°, dragged up and down. Reports values in minimum..maximum.
// Controlled: it shows `value`, except while it is held, when it shows its own drag position, so
// that a snapshot arriving mid-drag cannot pull it back.
export component Knob inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> active: true;
    in property <bool> enabled: true;
    in property <bool> bipolar;
    // What it shows: the value, or the drag position while held.
    out property <float> shown: area.pressed ? root.drag-value : root.value;
    callback moved(float);
    callback released(float);
    width: 52px;
    height: 52px;
    opacity: root.enabled ? 1 : 0.45;
    property <float> fraction: (root.shown - root.minimum) / max(0.0001, root.maximum - root.minimum);
    property <angle> start: 135deg;
    property <angle> needle: root.start + root.fraction * 270deg;
    property <float> grab-value;
    property <float> drag-value;

    function clamped(v: float) -> float {
        return max(root.minimum, min(root.maximum, v));
    }
    // A number in path commands: always with a decimal point, whatever the language's decimal
    // mark (a "10,44" would not parse, and the knob would not be drawn).
    pure function unlocalized(v: float) -> string {
        return v.to-string-unlocalized();
    }

    // track and value arcs, drawn as paths in a 52 × 52 box around (26, 26), radius 22
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 52;
        viewbox-height: 52;
        stroke: Palette.hairline;
        stroke-width: 3px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M \{root.unlocalized(26 + 22 * cos(135deg))} \{root.unlocalized(26 + 22 * sin(135deg))} A 22 22 0 1 1 \{root.unlocalized(26 + 22 * cos(45deg))} \{root.unlocalized(26 + 22 * sin(45deg))}";
    }
    Path {
        property <angle> from: root.bipolar ? 270deg : root.start;
        property <angle> to: root.needle;
        property <bool> large: abs((self.to - self.from) / 1deg) > 180;
        property <bool> sweep: self.to > self.from;
        visible: abs((self.to - self.from) / 1deg) > 0.5;
        width: 100%;
        height: 100%;
        viewbox-width: 52;
        viewbox-height: 52;
        stroke: root.active ? Palette.light : Palette.faint;
        stroke-width: 3px;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M \{root.unlocalized(26 + 22 * cos(self.from))} \{root.unlocalized(26 + 22 * sin(self.from))} A 22 22 0 \{self.large ? 1 : 0} \{self.sweep ? 1 : 0} \{root.unlocalized(26 + 22 * cos(self.to))} \{root.unlocalized(26 + 22 * sin(self.to))}";
    }
    // body
    Rectangle {
        x: 10px;
        y: 10px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: @radial-gradient(circle, #2b2d32 0%, #1a1b1e 100%);
        border-width: 1px;
        border-color: Palette.edge;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 52;
        viewbox-height: 52;
        stroke: root.active ? Palette.light : Palette.dim;
        stroke-width: 2px;
        stroke-line-cap: round;
        commands: "M \{root.unlocalized(26 + 6 * cos(root.needle))} \{root.unlocalized(26 + 6 * sin(root.needle))} L \{root.unlocalized(26 + 13 * cos(root.needle))} \{root.unlocalized(26 + 13 * sin(root.needle))}";
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.grab-value = root.value;
                root.drag-value = root.value;
            }
            if (event.kind == PointerEventKind.up) {
                root.released(root.drag-value);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-value = root.clamped(root.grab-value + (self.pressed-y - self.mouse-y) / 150px * (root.maximum - root.minimum));
                root.moved(root.drag-value);
            }
        }
        scroll-event(event) => {
            root.moved(root.clamped(root.value + (event.delta-y > 0 ? 1 : -1) * (root.maximum - root.minimum) / 50));
            root.released(root.clamped(root.value + (event.delta-y > 0 ? 1 : -1) * (root.maximum - root.minimum) / 50));
            return accept;
        }
    }
}

// A number shown as plain text that can be typed over: the value under a knob or a fader. A click
// (or the keyboard focus, from Tab) turns it into a field holding the number, all selected; Enter or
// leaving the field gives what was typed to `accepted`, Escape gives it up. The owner reads the text
// (Backend.typed-value: decimal comma or point, unit optional, clamped and rounded) and writes the
// value as a drag would. Not editing, it draws exactly the text it was given; under the pointer, a
// faint box says it can be typed in.
export component ValueEdit inherits Rectangle {
    // What it shows, unit included ("40 %", "+3,5 dB"), and the number the field starts from.
    in property <string> text;
    in property <string> number;
    in property <bool> enabled: true;
    in property <color> text-color: Palette.text;
    in property <length> font-size: 13px;
    in property <int> font-weight: 400;
    // Centred under a knob; at the left under a fader, where the unit follows it.
    in property <bool> centered: true;
    // Layout check only: starts editing.
    in property <bool> open-request;
    callback accepted(string);
    out property <bool> editing: input.has-focus;
    // What was typed has been given or given up: losing the focus afterwards gives nothing more.
    property <bool> settled: true;
    property <length> box-width: max(measure.preferred-width + 10px, root.editing ? 64px : 0px);
    changed open-request => {
        if (root.open-request && root.enabled) {
            root.start();
        }
    }
    // Created with the request already set (a tab opened for the layout check).
    init => {
        if (root.open-request && root.enabled) {
            root.start();
        }
    }
    // Opens the field on the number shown, all selected: typing replaces it.
    function start() {
        root.settled = false;
        input.text = root.number;
        input.focus();
        input.select-all();
    }
    preferred-width: measure.preferred-width;
    min-width: measure.preferred-width;
    preferred-height: measure.preferred-height;
    // Above the unit next to it while the field is wider than the number.
    z: root.editing ? 1 : 0;
    // The text's own size, measured apart: the label below is sized from the box, which is sized
    // from this.
    measure := Text {
        visible: false;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
    }
    Rectangle {
        x: root.centered ? (root.width - self.width) / 2 : -5px;
        width: root.box-width;
        height: root.height;
        border-radius: 3px;
        background: root.editing ? Palette.well : (area.has-hover && root.enabled ? #ffffff0d : transparent);
        border-width: 1px;
        border-color: root.editing ? Palette.light : (area.has-hover && root.enabled ? Palette.hairline : transparent);
        area := TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.text;
            clicked => { root.start(); }
        }
        label := Text {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.text;
            color: root.text-color;
            font-size: root.font-size;
            font-weight: root.font-weight;
            visible: !root.editing;
        }
        input := TextInput {
            x: 4px;
            width: parent.width - 8px;
            height: parent.height;
            enabled: root.enabled;
            horizontal-alignment: center;
            vertical-alignment: center;
            single-line: true;
            font-size: root.font-size;
            font-weight: root.font-weight;
            color: self.has-focus ? Palette.text : transparent;
            selection-background-color: #ffffff40;
            // The focus reached by a click on the field itself or by Tab opens it as `start` does.
            changed has-focus => {
                if (self.has-focus && root.settled) {
                    root.settled = false;
                    self.text = root.number;
                    self.select-all();
                } else if (!self.has-focus && !root.settled) {
                    root.settled = true;
                    if (self.text != root.number) {
                        root.accepted(self.text);
                    }
                }
            }
            accepted => {
                root.settled = true;
                if (self.text != root.number) {
                    root.accepted(self.text);
                }
                self.clear-focus();
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.settled = true;
                    self.clear-focus();
                    return accept;
                }
                return reject;
            }
        }
    }
}

// A small box showing a level in percent (a device's Windows volume), changed by dragging up and
// down or with the wheel. Controlled, like the knob.
export component LevelBox inherits Rectangle {
    in property <float> value;
    in property <bool> known: true;
    in property <bool> muted;
    callback moved(float);
    width: 52px;
    height: 30px;
    border-radius: 4px;
    background: area.has-hover && root.known ? Palette.raised : Palette.well;
    border-width: 1px;
    border-color: area.pressed ? Palette.edge : Palette.hairline;
    property <float> grab-value;
    property <float> drag-value;
    property <float> shown: area.pressed ? root.drag-value : root.value;
    Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: !root.known ? "—" : (root.muted ? @tr("muet") : "\{round(root.shown * 100)} %");
        color: root.known && !root.muted ? Palette.text : Palette.faint;
        font-size: 12px;
    }
    area := TouchArea {
        enabled: root.known;
        mouse-cursor: ns-resize;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.grab-value = root.value;
                root.drag-value = root.value;
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-value = max(0, min(1, root.grab-value + (self.pressed-y - self.mouse-y) / 150px));
                root.moved(root.drag-value);
            }
        }
        scroll-event(event) => {
            root.moved(max(0, min(1, root.value + (event.delta-y > 0 ? 0.02 : -0.02))));
            return accept;
        }
    }
}

// A square button with an icon, lit when active.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <color> active-tint: Palette.base;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 4px;
    opacity: root.enabled ? 1 : 0.35;
    background: root.active ? Palette.light : (area.has-hover && root.enabled ? Palette.raised : transparent);
    border-width: 1px;
    border-color: root.active ? Palette.light : Palette.edge;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        size: 16px;
        tint: root.active ? root.active-tint : Palette.dim;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A text button.
export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    min-width: max(96px, label.preferred-width + 32px);
    height: 30px;
    border-radius: 4px;
    opacity: root.enabled ? 1 : 0.35;
    background: root.primary ? (area.has-hover && root.enabled ? #ffffff : Palette.light) : (area.has-hover && root.enabled ? Palette.raised : transparent);
    border-width: 1px;
    border-color: root.primary ? Palette.light : Palette.edge;
    label := Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.primary ? Palette.base : Palette.text;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A drop-down list in the same style as the rest.
export component Select inherits Rectangle {
    in property <[string]> model;
    in property <int> current;
    // Shown when nothing is chosen.
    in property <string> placeholder: "—";
    in property <bool> enabled: true;
    // Layout check only: opens the list.
    in property <bool> open-request;
    // A line under the choices that opens something else (GG's device manager under its device
    // menus); none when empty.
    in property <string> action;
    in property <string> action-icon: "settings";
    callback chosen(int);
    callback act();
    changed open-request => {
        if (root.open-request) {
            popup.show();
        }
    }
    height: 30px;
    border-radius: 4px;
    opacity: root.enabled ? 1 : 0.4;
    background: area.has-hover && root.enabled ? Palette.raised : Palette.well;
    border-width: 1px;
    border-color: Palette.hairline;
    property <bool> chosen-one: root.current >= 0 && root.current < root.model.length;
    Text {
        x: 10px;
        width: parent.width - 34px;
        height: parent.height;
        text: root.chosen-one ? root.model[root.current] : root.placeholder;
        color: root.chosen-one ? Palette.text : Palette.dim;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: parent.width - 22px;
        y: (parent.height - self.height) / 2;
        name: "chevron";
        size: 14px;
        tint: Palette.dim;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 220px);
        Rectangle {
            background: Palette.raised;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.edge;
            drop-shadow-blur: 16px;
            drop-shadow-color: #000000c0;
            VerticalLayout {
                padding: 4px;
                for item[index] in root.model: Rectangle {
                    height: 30px;
                    border-radius: 3px;
                    background: row.has-hover ? #ffffff10 : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            name: "check";
                            size: 14px;
                            tint: index == root.current ? Palette.light : transparent;
                        }
                        Text {
                            text: item;
                            color: Palette.text;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    row := TouchArea {
                        clicked => { root.chosen(index); }
                    }
                }
                if root.action != "": Rectangle {
                    height: 9px;
                    Rectangle {
                        y: 4px;
                        height: 1px;
                        background: Palette.hairline;
                    }
                }
                if root.action != "": Rectangle {
                    height: 30px;
                    border-radius: 3px;
                    background: action-area.has-hover ? #ffffff10 : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        Icon {
                            y: (parent.height - self.height) / 2;
                            name: root.action-icon;
                            size: 14px;
                            tint: Palette.dim;
                        }
                        Text {
                            text: root.action;
                            color: Palette.dim;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    action-area := TouchArea {
                        clicked => { root.act(); }
                    }
                }
            }
        }
    }
}

// A horizontal slider over 0..1 (positions; Rust turns them into the field's own scale), for GG's
// controls that show words at both ends rather than a number. Controlled, like the knob: it shows
// `value`, or its own drag position while held. `released` gives the position once let go (or
// after a wheel step), for a value that is saved rather than heard while it moves.
export component Slider inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    in property <bool> active: true;
    out property <float> shown: area.pressed ? root.drag-value : root.value;
    callback moved(float);
    callback released(float);
    height: 22px;
    opacity: root.enabled ? 1 : 0.35;
    property <length> cap: 12px;
    property <float> drag-value;
    property <float> wheel-value;
    function position(x: length) -> float {
        return max(0, min(1, (x - root.cap / 2) / (root.width - root.cap)));
    }
    Rectangle {
        x: root.cap / 2;
        y: (root.height - self.height) / 2;
        width: root.width - root.cap;
        height: 4px;
        border-radius: 2px;
        background: Palette.well;
        border-width: 1px;
        border-color: #00000080;
    }
    Rectangle {
        x: root.cap / 2;
        y: (root.height - self.height) / 2;
        width: (root.width - root.cap) * root.shown;
        height: 4px;
        border-radius: 2px;
        background: root.active ? Palette.light : Palette.faint;
    }
    Rectangle {
        x: (root.width - root.cap) * root.shown;
        y: (root.height - self.height) / 2;
        width: root.cap;
        height: 18px;
        border-radius: 3px;
        background: root.active ? @linear-gradient(180deg, Palette.metal-top 0%, Palette.metal-bottom 100%) : @linear-gradient(180deg, #8d9198 0%, #5d6168 100%);
        drop-shadow-blur: 4px;
        drop-shadow-color: #000000a0;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.drag-value = root.position(self.mouse-x);
                root.moved(root.drag-value);
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.released(root.drag-value);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-value = root.position(self.mouse-x);
                root.moved(root.drag-value);
            }
        }
        scroll-event(event) => {
            // Worked out once: `moved` may change `value` before `released` is called.
            root.wheel-value = max(0, min(1, root.value + (event.delta-y > 0 ? 0.02 : -0.02)));
            root.moved(root.wheel-value);
            root.released(root.wheel-value);
            return accept;
        }
    }
}

// Two or three choices side by side, one lit (headphones or speakers, a loudness).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <bool> enabled: true;
    callback chosen(int);
    height: 26px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.edge;
    opacity: root.enabled ? 1 : 0.35;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for option[index] in root.options: Rectangle {
            border-radius: 3px;
            background: index == root.current ? Palette.light : (cell.has-hover && root.enabled ? Palette.raised : transparent);
            min-width: label.preferred-width + 20px;
            label := Text {
                width: parent.width;
                height: parent.height;
                text: option;
                color: index == root.current ? Palette.base : Palette.dim;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            cell := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.chosen(index); }
            }
        }
    }
}

// A one-line text field with a placeholder. The text is the field's own (it is not a value Rust
// shows): `edited` and `accepted` say what was typed.
export component TextField inherits Rectangle {
    in property <string> placeholder;
    in property <string> icon;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted(string);
    // focus() comes with forward-focus.
    public function select-all() {
        input.select-all();
    }
    height: 30px;
    border-radius: 4px;
    background: Palette.well;
    border-width: 1px;
    border-color: input.has-focus ? Palette.edge : Palette.hairline;
    forward-focus: input;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            name: root.icon;
            size: 14px;
            tint: Palette.faint;
        }
        Rectangle {
            input := TextInput {
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                color: Palette.text;
                selection-background-color: #ffffff40;
                font-size: 12px;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            if input.text == "": Text {
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                text: root.placeholder;
                color: Palette.faint;
                font-size: 12px;
            }
        }
    }
}

// When a change of an option takes effect, in small print under it (the settings page).
export component AppliesNote inherits HorizontalLayout {
    in property <string> text;
    spacing: 6px;
    Icon {
        y: 1px;
        name: "info";
        size: 12px;
        tint: Palette.faint;
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        color: Palette.faint;
        font-size: 10px;
        wrap: word-wrap;
    }
}

// One line of a popup menu.
export component MenuLine inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> checked;
    callback clicked;
    height: 30px;
    border-radius: 3px;
    background: area.has-hover && root.enabled ? #ffffff10 : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Icon {
            y: (parent.height - self.height) / 2;
            name: root.checked ? "check" : root.icon;
            size: 14px;
            tint: root.enabled ? Palette.light : Palette.faint;
        }
        Text {
            text: root.text;
            color: root.enabled ? Palette.text : Palette.faint;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// The frame of a popup menu.
export component MenuFrame inherits Rectangle {
    background: Palette.raised;
    border-radius: 4px;
    border-width: 1px;
    border-color: Palette.edge;
    drop-shadow-blur: 16px;
    drop-shadow-color: #000000c0;
    VerticalLayout {
        padding: 4px;
        @children
    }
}

export component MenuSeparator inherits Rectangle {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: Palette.hairline;
    }
}
